{
  "delay": 120,
  "settle": 800,
  "log": false,
  "steps": [
    { "label": "README: the main window (docs/screenshots, each PNG under 300 KB)" },
    { "do": "expect", "probe": "window.maximized", "eq": true },
    { "do": "open", "file": "samples/readme-demo.mp4" },
    { "do": "waitFor", "probe": "video.state", "eq": "ready", "timeout": 15000 },
    { "do": "wait", "ms": 500 },
    { "do": "key", "keys": "U", "on": "MainWindow" },
    { "do": "drag", "on": "canvas", "space": "canvas", "from": [660, 240], "to": [1260, 840], "steps": 20 },
    { "do": "type", "on": "options.rounded.w", "text": "600" },
    { "do": "type", "on": "options.rounded.h", "text": "600" },
    { "do": "type", "on": "options.rounded.x", "text": "660" },
    { "do": "type", "on": "options.rounded.y", "text": "240" },
    { "do": "type", "on": "options.rounded.radius", "text": "96" },
    { "do": "type", "on": "options.rounded.feather", "text": "24" },
    { "do": "click", "on": "canvas", "space": "canvas", "at": [960, 540] },
    { "do": "type", "on": "transport.time", "text": "2" },
    { "do": "key", "keys": "I", "on": "MainWindow" },
    { "do": "type", "on": "transport.time", "text": "7.5" },
    { "do": "key", "keys": "O", "on": "MainWindow" },
    { "do": "type", "on": "transport.time", "text": "4.2" },
    { "do": "waitFor", "probe": "timeline.thumbs", "min": 300, "timeout": 15000 },
    { "do": "wait", "ms": 300 },
    { "do": "shot", "file": "main-window.png", "maxWidth": 1280 },

    { "label": "the timeline: the In–Out range, its thumbnails, the crossfade band" },
    { "do": "shot", "on": "timeline", "file": "timeline.png", "maxWidth": 1360 },

    { "label": "the Preview window: only the exported part, over the checker" },
    { "do": "key", "keys": "F5", "on": "MainWindow" },
    { "do": "waitFor", "probe": "preview.cached", "min": 150, "timeout": 60000 },
    { "do": "previewSeek", "at": 60 },
    { "do": "wait", "ms": 500 },
    { "do": "shot", "on": "PreviewWindow", "file": "preview.png", "maxWidth": 1000 },
    { "do": "previewClose" },

    { "label": "an ellipse crop with a soft edge" },
    { "do": "key", "keys": "E", "on": "MainWindow" },
    { "do": "drag", "on": "canvas", "space": "canvas", "from": [560, 240], "to": [1360, 840], "steps": 20 },
    { "do": "type", "on": "options.ellipse.feather", "text": "32" },
    { "do": "wait", "ms": 300 },
    { "do": "shot", "on": "CanvasArea", "file": "crop-ellipse.png", "maxWidth": 1100 },

    { "label": "an export just written, with the OBS tip (the file goes into build/, never the repository)" },
    { "do": "exportTo", "file": "../../build/readme-export.webm" },
    { "do": "waitFor", "probe": "export.state", "eq": "done", "timeout": 120000 },
    { "do": "wait", "ms": 300 },
    { "do": "shot", "file": "export.png", "maxWidth": 1200 },

    { "label": "the batch queue: three formats, two written, the third on its way (into the lab run's folder)" },
    { "do": "batchAdd", "file": "overlay.webm", "temp": true },
    { "do": "choose", "on": "panel.output.format", "data": "gif" },
    { "do": "batchAdd", "file": "overlay.gif", "temp": true },
    { "do": "choose", "on": "panel.output.format", "data": "mov-prores" },
    { "do": "batchAdd", "file": "overlay.mov", "temp": true },
    { "do": "choose", "on": "panel.output.format", "data": "webm-vp9" },
    { "do": "menu", "path": ["Batch Queue…"] },
    { "do": "batchStart" },
    { "do": "waitFor", "probe": "batch.states", "eq": "done,done,running", "timeout": 120000 },
    { "do": "wait", "ms": 1500 },
    { "do": "shot", "on": "BatchWindow", "file": "batch.png" },
    { "do": "waitFor", "probe": "batch.states", "eq": "done,done,done", "timeout": 120000 },
    { "do": "batchClose" },

    { "label": "Settings, the Performance tab" },
    { "do": "key", "keys": "Ctrl+,", "on": "MainWindow" },
    { "do": "key", "keys": "Ctrl+Tab", "on": "settings.tabs" },
    { "do": "shot", "on": "SettingsDialog", "file": "settings.png" },
    { "do": "click", "on": "settings.close" },

    { "label": "Clip effects: a warmer, livelier look with a vignette — the canvas and the section" },
    { "do": "type", "on": "panel.effects.exposure", "text": "0.3" },
    { "do": "type", "on": "panel.effects.contrast", "text": "15" },
    { "do": "type", "on": "panel.effects.temperature", "text": "35" },
    { "do": "type", "on": "panel.effects.vibrance", "text": "40" },
    { "do": "type", "on": "panel.effects.vignette", "text": "45" },
    { "do": "wait", "ms": 300 },
    { "do": "shot", "on": "CanvasArea", "file": "clip-effects.png", "maxWidth": 1100 },
    { "do": "shot", "on": "Section.effects", "file": "clip-effects-panel.png" }
  ]
}
