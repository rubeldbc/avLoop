{
  "delay": 120,
  "settle": 700,
  "steps": [
    { "label": "D-022: the counter at 100 %, no crop; S, the Shape tool; no shapes (a canvas point lands ½ px in, as walk-crop's)" },
    { "do": "open", "file": "samples/counter-640p30.mp4" },
    { "do": "waitFor", "probe": "video.state", "eq": "ready", "timeout": 10000 },
    { "do": "wait", "ms": 300 },
    { "do": "key", "keys": "Ctrl+1", "on": "MainWindow" },
    { "do": "key", "keys": "S", "on": "MainWindow" },
    { "do": "expect", "probe": "tool.active", "eq": "shape" },
    { "do": "expect", "probe": "shapes.count", "eq": 0 },
    { "do": "expect", "probe": "panel.crop.output", "eq": "640 × 360" },

    { "label": "a rectangle drawn (Select): one Undo step, selected; the output needs alpha" },
    { "do": "drag", "on": "canvas", "space": "canvas", "from": [100, 60], "to": [300, 200], "steps": 16 },
    { "do": "expect", "probe": "shapes.count", "eq": 1 },
    { "do": "expect", "probe": "shapes.summary", "eq": "rect:add:101,60,200,140" },
    { "do": "expect", "probe": "shapes.selected", "eq": "0" },
    { "do": "expect", "probe": "undo.count", "eq": 1 },
    { "do": "expect", "probe": "options.shape.w", "near": [200, 0.6] },
    { "do": "expect", "probe": "panel.crop.output", "eq": "640 × 360 · alpha" },

    { "label": "moved by a drag inside; resized by its bottom-right handle; each one step" },
    { "do": "drag", "on": "canvas", "space": "canvas", "from": [200, 130], "to": [240, 150], "steps": 12 },
    { "do": "expect", "probe": "shapes.summary", "eq": "rect:add:141,80,200,140" },
    { "do": "drag", "on": "canvas", "space": "canvas", "from": [340, 220], "to": [380, 240], "steps": 12 },
    { "do": "expect", "probe": "shapes.summary", "eq": "rect:add:141,80,240,160" },
    { "do": "expect", "probe": "undo.count", "eq": 3 },

    { "label": "Esc deselects; an ellipse that cuts, drawn beside it" },
    { "do": "key", "keys": "Escape", "on": "canvas" },
    { "do": "expect", "probe": "shapes.selected", "eq": "" },
    { "do": "choose", "on": "options.shape.kind", "data": 2 },
    { "do": "choose", "on": "options.shape.role", "data": 1 },
    { "do": "expect", "probe": "shapes.summary", "eq": "rect:add:141,80,240,160" },
    { "do": "drag", "on": "canvas", "space": "canvas", "from": [400, 160], "to": [560, 320], "steps": 16 },
    { "do": "expect", "probe": "shapes.summary", "eq": "rect:add:141,80,240,160;ellipse:cut:401,160,160,160" },

    { "label": "a polygon of five clicks, closed on its first anchor (Select)" },
    { "do": "key", "keys": "Escape", "on": "canvas" },
    { "do": "choose", "on": "options.shape.kind", "data": 3 },
    { "do": "choose", "on": "options.shape.role", "data": 0 },
    { "do": "click", "on": "canvas", "space": "canvas", "at": [20, 230] },
    { "do": "expect", "probe": "shape.mode", "eq": "polygon" },
    { "do": "click", "on": "canvas", "space": "canvas", "at": [120, 250] },
    { "do": "click", "on": "canvas", "space": "canvas", "at": [110, 330] },
    { "do": "click", "on": "canvas", "space": "canvas", "at": [40, 340] },
    { "do": "click", "on": "canvas", "space": "canvas", "at": [10, 290] },
    { "do": "expect", "probe": "shape.points", "eq": 5 },
    { "do": "click", "on": "canvas", "space": "canvas", "at": [21, 231] },
    { "do": "expect", "probe": "shape.mode", "eq": "none" },
    { "do": "expect", "probe": "shapes.count", "eq": 3 },
    { "do": "expect", "probe": "shapes.summary", "contains": "polygon:add:n5" },

    { "label": "Esc cancels a polygon being drawn" },
    { "do": "key", "keys": "Escape", "on": "canvas" },
    { "do": "click", "on": "canvas", "space": "canvas", "at": [600, 20] },
    { "do": "click", "on": "canvas", "space": "canvas", "at": [630, 40] },
    { "do": "key", "keys": "Escape", "on": "canvas" },
    { "do": "expect", "probe": "shape.mode", "eq": "none" },
    { "do": "expect", "probe": "shapes.count", "eq": 3 },

    { "label": "a freehand outline dragged round, simplified, closed" },
    { "do": "choose", "on": "options.shape.kind", "data": 4 },
    { "do": "drag", "on": "canvas", "space": "canvas", "from": [520, 20], "to": [520, 24], "steps": 6,
      "via": [[600, 30], [620, 90], [560, 130], [500, 100], [490, 50]] },
    { "do": "expect", "probe": "shapes.count", "eq": 4 },
    { "do": "expect", "probe": "shapes.summary", "contains": ";polygon:add:n" },
    { "do": "expect", "probe": "panel.shapes.rows", "eq": "Polygon 2 · Select|Polygon 1 · Select|Ellipse 1 · Cut|Rectangle 1 · Select" },
    { "do": "shot", "on": "canvas", "file": "canvas-shapes.png", "maxWidth": 1200 },
    { "do": "shot", "on": "Section.crop", "file": "panel-shapes.png" },

    { "label": "a click selects the rectangle; the Crop section's Role makes it cut; Delete removes it; Undo" },
    { "do": "click", "on": "canvas", "space": "canvas", "at": [200, 100] },
    { "do": "expect", "probe": "shapes.selected", "eq": "0" },
    { "do": "choose", "on": "panel.shapes.role", "data": 1 },
    { "do": "expect", "probe": "shapes.summary", "contains": "rect:cut:141,80,240,160" },
    { "do": "key", "keys": "Ctrl+Z", "on": "MainWindow" },
    { "do": "expect", "probe": "shapes.summary", "contains": "rect:add:141,80,240,160" },
    { "do": "key", "keys": "Delete", "on": "canvas" },
    { "do": "expect", "probe": "shapes.count", "eq": 3 },
    { "do": "key", "keys": "Ctrl+Z", "on": "MainWindow" },
    { "do": "expect", "probe": "shapes.count", "eq": 4 },

    { "label": "the Preview: the shapes' mask, exactly" },
    { "do": "key", "keys": "F5", "on": "MainWindow" },
    { "do": "expect", "probe": "preview.open", "eq": true },
    { "do": "waitFor", "probe": "preview.frame", "eq": "640x360", "timeout": 10000 },
    { "do": "wait", "ms": 800 },
    { "do": "shot", "on": "PreviewWindow", "file": "preview-shapes.png", "maxWidth": 1000 },
    { "do": "previewClose" }
  ]
}
