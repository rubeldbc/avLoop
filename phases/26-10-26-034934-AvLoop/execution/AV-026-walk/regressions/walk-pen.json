{
  "delay": 120,
  "settle": 700,
  "steps": [
    { "label": "D-022 (AV-025): the counter at 100 %; P, the Pen" },
    { "do": "open", "file": "samples/counter-640p30.mp4" },
    { "do": "waitFor", "probe": "video.state", "eq": "ready", "timeout": 10000 },
    { "do": "wait", "ms": 300 },
    { "do": "key", "keys": "Ctrl+1", "on": "MainWindow" },
    { "do": "key", "keys": "P", "on": "MainWindow" },
    { "do": "expect", "probe": "tool.active", "eq": "pen" },

    { "label": "clicks make corners, a drag a smooth anchor; a click on the first closes the path (one Undo step)" },
    { "do": "click", "on": "canvas", "space": "canvas", "at": [100, 100] },
    { "do": "expect", "probe": "pen.drawing", "eq": 1 },
    { "do": "click", "on": "canvas", "space": "canvas", "at": [300, 100] },
    { "do": "drag", "on": "canvas", "space": "canvas", "from": [300, 300], "to": [340, 300], "steps": 8 },
    { "do": "click", "on": "canvas", "space": "canvas", "at": [100, 300] },
    { "do": "expect", "probe": "pen.drawing", "eq": 4 },
    { "do": "expect", "probe": "shapes.count", "eq": 0 },
    { "do": "click", "on": "canvas", "space": "canvas", "at": [101, 101] },
    { "do": "expect", "probe": "pen.drawing", "eq": 0 },
    { "do": "expect", "probe": "shapes.count", "eq": 1 },
    { "do": "expect", "probe": "shapes.summary", "eq": "path:add:n4" },
    { "do": "expect", "probe": "pen.anchors", "eq": "c,c,s,c" },
    { "do": "expect", "probe": "undo.count", "eq": 1 },
    { "do": "shot", "on": "canvas", "file": "canvas-pen-drawn.png", "maxWidth": 1200 },

    { "label": "Alt+click converts the smooth anchor to a corner, and back (handles along its neighbours)" },
    { "do": "click", "on": "canvas", "space": "canvas", "at": [300, 300], "mods": "Alt" },
    { "do": "expect", "probe": "pen.anchors", "eq": "c,c,c,c" },
    { "do": "click", "on": "canvas", "space": "canvas", "at": [300, 300], "mods": "Alt" },
    { "do": "expect", "probe": "pen.anchors", "eq": "c,c,s,c" },
    { "do": "expect", "probe": "undo.count", "eq": 3 },

    { "label": "a click on the top segment adds an anchor there; Delete removes it" },
    { "do": "click", "on": "canvas", "space": "canvas", "at": [200, 100] },
    { "do": "expect", "probe": "shapes.summary", "eq": "path:add:n5" },
    { "do": "expect", "probe": "pen.anchors", "eq": "c,c,c,s,c" },
    { "do": "expect", "probe": "pen.anchor", "eq": 1 },
    { "do": "key", "keys": "Delete", "on": "canvas" },
    { "do": "expect", "probe": "shapes.summary", "eq": "path:add:n4" },
    { "do": "expect", "probe": "pen.anchors", "eq": "c,c,s,c" },

    { "label": "Alt+drag of the smooth anchor's out handle breaks the pair; a drag of an anchor moves it" },
    { "do": "drag", "on": "canvas", "space": "canvas", "from": [252.9, 347.1], "to": [252.9, 390], "steps": 10, "mods": "Alt" },
    { "do": "expect", "probe": "pen.anchors", "eq": "c,c,b,c" },
    { "do": "drag", "on": "canvas", "space": "canvas", "from": [100, 100], "to": [120, 80], "steps": 8 },
    { "do": "expect", "probe": "shapes.count", "eq": 1 },
    { "do": "shot", "on": "canvas", "file": "canvas-pen-edited.png", "maxWidth": 1200 },

    { "label": "Ctrl+click beside it selects nothing; Esc drops a path begun; Enter closes another" },
    { "do": "click", "on": "canvas", "space": "canvas", "at": [500, 300], "mods": "Ctrl" },
    { "do": "expect", "probe": "shapes.selected", "eq": "" },
    { "do": "click", "on": "canvas", "space": "canvas", "at": [450, 40] },
    { "do": "click", "on": "canvas", "space": "canvas", "at": [550, 40] },
    { "do": "expect", "probe": "pen.drawing", "eq": 2 },
    { "do": "key", "keys": "Escape", "on": "canvas" },
    { "do": "expect", "probe": "pen.drawing", "eq": 0 },
    { "do": "expect", "probe": "shapes.count", "eq": 1 },
    { "do": "choose", "on": "options.pen.role", "data": 1 },
    { "do": "click", "on": "canvas", "space": "canvas", "at": [420, 180] },
    { "do": "click", "on": "canvas", "space": "canvas", "at": [600, 180] },
    { "do": "drag", "on": "canvas", "space": "canvas", "from": [520, 340], "to": [560, 340], "steps": 8 },
    { "do": "key", "keys": "Return", "on": "canvas" },
    { "do": "expect", "probe": "shapes.count", "eq": 2 },
    { "do": "expect", "probe": "shapes.summary", "contains": ";path:cut:n3" },
    { "do": "expect", "probe": "pen.anchors", "eq": "c,c,s" },

    { "label": "the Preview: the curves exactly; Undo takes the second path away" },
    { "do": "key", "keys": "F5", "on": "MainWindow" },
    { "do": "expect", "probe": "preview.open", "eq": true },
    { "do": "waitFor", "probe": "preview.frame", "eq": "640x360", "timeout": 10000 },
    { "do": "wait", "ms": 800 },
    { "do": "shot", "on": "PreviewWindow", "file": "preview-pen.png", "maxWidth": 1000 },
    { "do": "previewClose" },
    { "do": "key", "keys": "Ctrl+Z", "on": "MainWindow" },
    { "do": "expect", "probe": "shapes.count", "eq": 1 }
  ]
}
