{
  "delay": 120,
  "settle": 700,
  "steps": [
    { "label": "no video: Export disabled, with the reason" },
    { "do": "expect", "probe": "export.enabled", "eq": false },
    { "do": "expect", "probe": "export.reason", "eq": "Open a video to export it" },

    { "label": "a 3 s Crossfade loop of the counter, an Ellipse with Feather" },
    { "do": "open", "file": "samples/counter-640p30.mp4" },
    { "do": "waitFor", "probe": "video.state", "eq": "ready", "timeout": 10000 },
    { "do": "type", "on": "transport.time", "text": "2" },
    { "do": "key", "keys": "I", "on": "MainWindow" },
    { "do": "type", "on": "transport.time", "text": "4.9667" },
    { "do": "key", "keys": "O", "on": "MainWindow" },
    { "do": "key", "keys": "E", "on": "MainWindow" },
    { "do": "dclick", "on": "canvas", "space": "canvas", "at": [320, 180] },
    { "do": "type", "on": "panel.crop.feather", "text": "8" },
    { "do": "expect", "probe": "export.enabled", "eq": true },
    { "do": "expect", "probe": "export.reason", "eq": "" },
    { "do": "expect", "probe": "export.defaultName", "eq": "counter-640p30_loop_640x360.webm" },

    { "label": "Output: Size — Crop, Long side, Custom with and without the lock, the 1920 limit" },
    { "do": "expect", "probe": "output.sizeMode", "eq": "crop" },
    { "do": "expect", "probe": "output.size", "eq": "640x360" },
    { "do": "choose", "on": "panel.output.size", "data": "long-256" },
    { "do": "expect", "probe": "output.size", "eq": "256x144" },
    { "do": "expect", "probe": "crop.output", "eq": "640x360" },
    { "do": "choose", "on": "panel.output.size", "data": "custom" },
    { "do": "expect", "probe": "output.size", "eq": "256x144" },
    { "do": "type", "on": "panel.output.w", "text": "500" },
    { "do": "expect", "probe": "output.size", "eq": "500x282" },
    { "do": "click", "on": "panel.output.lock" },
    { "do": "type", "on": "panel.output.h", "text": "300" },
    { "do": "expect", "probe": "output.size", "eq": "500x300" },
    { "do": "type", "on": "panel.output.w", "text": "4000" },
    { "do": "expect", "probe": "output.size", "eq": "1920x144" },
    { "do": "expect", "probe": "output.note", "contains": "Limited to 1920 px" },
    { "do": "shot", "on": "Section.output", "file": "output-panel.png" },
    { "do": "choose", "on": "panel.output.size", "data": "crop" },
    { "do": "expect", "probe": "output.size", "eq": "640x360" },
    { "do": "expect", "probe": "output.note", "eq": "" },

    { "label": "Output: Alpha Auto (on: the ellipse leaves corners clear), Off with a Background, Format VP8" },
    { "do": "expect", "probe": "output.alpha", "eq": "on" },
    { "do": "choose", "on": "panel.output.alpha", "data": "off" },
    { "do": "expect", "probe": "output.alpha", "eq": "off" },
    { "do": "type", "on": "panel.output.background", "text": "#FF00FF" },
    { "do": "expect", "probe": "output.background", "eq": "#ff00ff" },
    { "do": "choose", "on": "panel.output.alpha", "data": "auto" },
    { "do": "expect", "probe": "output.alpha", "eq": "on" },
    { "do": "choose", "on": "panel.output.format", "data": "webm-vp8" },
    { "do": "expect", "probe": "output.format", "eq": "webm-vp8" },
    { "do": "choose", "on": "panel.output.format", "data": "webm-vp9" },

    { "label": "Quality: a preset's values, typed into Custom, back to Medium; the size estimate" },
    { "do": "choose", "on": "panel.quality.preset", "data": "high" },
    { "do": "expect", "probe": "quality.crf", "eq": 24 },
    { "do": "type", "on": "panel.quality.crf", "text": "33" },
    { "do": "expect", "probe": "quality.preset", "eq": "custom" },
    { "do": "expect", "probe": "quality.crf", "eq": 33 },
    { "do": "choose", "on": "panel.quality.preset", "data": "medium" },
    { "do": "expect", "probe": "quality.crf", "eq": 31 },
    { "do": "waitFor", "probe": "quality.estimate", "contains": "MB", "timeout": 20000 },
    { "do": "expect", "probe": "quality.estimate", "contains": "~" },
    { "do": "shot", "on": "Section.quality", "file": "quality-panel.png" },

    { "label": "Export: the loop written, checked, the toast with the OBS tip (once a session)" },
    { "do": "exportTo", "file": "export-a.webm" },
    { "do": "expect", "probe": "export.enabled", "eq": false },
    { "do": "waitFor", "probe": "export.state", "eq": "done", "timeout": 60000 },
    { "do": "expect", "probe": "export.verify", "eq": "" },
    { "do": "expect", "probe": "export.leftovers", "eq": "file" },
    { "do": "expect", "probe": "export.enabled", "eq": true },
    { "do": "expect", "probe": "toast.text", "contains": "Exported 640×360 · 2.50 s ·" },
    { "do": "expect", "probe": "toast.text", "contains": "OBS: Media Source → Loop on" },
    { "do": "shot", "on": "MainWindow", "file": "export-toast.png", "maxWidth": 1400 },
    { "do": "exportTo", "file": "export-b.webm" },
    { "do": "waitFor", "probe": "export.state", "eq": "done", "timeout": 60000 },
    { "do": "expect", "probe": "toast.text", "contains": "Exported 640×360" },
    { "do": "expect", "probe": "toast.text", "lacks": "OBS" },

    { "label": "Cancel: the progress in the status bar, then nothing left behind" },
    { "do": "choose", "on": "panel.quality.preset", "data": "custom" },
    { "do": "type", "on": "panel.quality.speed", "text": "0" },
    { "do": "exportTo", "file": "export-cancel.webm" },
    { "do": "waitFor", "probe": "export.done", "min": 3, "timeout": 30000 },
    { "do": "expect", "probe": "export.text", "contains": "Exporting " },
    { "do": "expect", "probe": "export.text", "contains": "fps · ETA" },
    { "do": "shot", "on": "status.export", "file": "export-bar.png" },
    { "do": "click", "on": "status.exportCancel" },
    { "do": "waitFor", "probe": "export.state", "eq": "cancelled", "timeout": 20000 },
    { "do": "expect", "probe": "export.leftovers", "eq": "none" },
    { "do": "expect", "probe": "toast.text", "eq": "Export cancelled" },

    { "label": "Closing during an export asks first: No keeps it running, Yes cancels it" },
    { "do": "exportTo", "file": "export-quit.webm" },
    { "do": "waitFor", "probe": "export.done", "min": 2, "timeout": 30000 },
    { "do": "answer", "yes": false },
    { "do": "closeWindow" },
    { "do": "expect", "probe": "question.last", "eq": "Export in progress — cancel and quit?" },
    { "do": "expect", "probe": "export.state", "eq": "running" },
    { "do": "answer", "yes": true },
    { "do": "closeWindow" },
    { "do": "waitFor", "probe": "export.state", "eq": "cancelled", "timeout": 20000 },
    { "do": "expect", "probe": "export.leftovers", "eq": "none" },
    { "do": "choose", "on": "panel.quality.preset", "data": "medium" },

    { "label": "A crop entirely outside the video: Export asks first (spec §12.2)" },
    { "do": "type", "on": "panel.crop.x", "text": "3000" },
    { "do": "expect", "probe": "status.notice", "eq": "Output is fully transparent" },
    { "do": "answer", "yes": false },
    { "do": "exportTo", "file": "export-clear.webm" },
    { "do": "expect", "probe": "question.last", "eq": "The output is fully transparent. Export it anyway?" },
    { "do": "expect", "probe": "export.state", "eq": "cancelled" },
    { "do": "key", "keys": "Ctrl+Z", "on": "MainWindow" },
    { "do": "expect", "probe": "status.notice", "eq": "" }
  ]
}
