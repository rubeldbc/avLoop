{
  "delay": 100,
  "settle": 600,
  "steps": [
    { "label": "S2 in the window: a video opens by the walk's open step (the code path of Open, drop and the command line)" },
    { "do": "open", "file": "samples/counter-640p30.mp4" },
    { "do": "waitFor", "probe": "video.state", "eq": "ready", "timeout": 10000 },
    { "do": "expect", "probe": "video.size", "eq": "640x360" },
    { "do": "expect", "probe": "frame.size", "eq": "640x360" },
    { "do": "expect", "probe": "status.source", "eq": "counter-640p30.mp4 · 640×360 · 30.00 fps · H.264" },
    { "do": "expect", "probe": "status.gpu", "contains": "HW decode on" },
    { "do": "expect", "probe": "status.memory", "contains": "Cache" },
    { "do": "expect", "probe": "dropzone.visible", "eq": false },
    { "do": "shot", "file": "open-counter.png", "maxWidth": 1600 },
    { "label": "a broken file: a message, not a crash; the open video stays" },
    { "do": "open", "file": "samples/broken.mp4" },
    { "do": "wait", "ms": 800 },
    { "do": "expect", "probe": "toast.text", "contains": "broken.mp4" },
    { "do": "expect", "probe": "video.size", "eq": "640x360" },
    { "do": "shot", "file": "open-broken-toast.png", "maxWidth": 1600 },
    { "label": "an audio-only file is refused with its reason" },
    { "do": "open", "file": "samples/audio-only.m4a" },
    { "do": "wait", "ms": 800 },
    { "do": "expect", "probe": "toast.text", "contains": "no video" },
    { "label": "rotation upright, a Bengali path, alpha, HDR" },
    { "do": "open", "file": "samples/rotate90.mp4" },
    { "do": "waitFor", "probe": "frame.size", "eq": "360x640", "timeout": 10000 },
    { "do": "shot", "file": "open-rotate90.png", "maxWidth": 1600 },
    { "do": "open", "file": "samples/বাংলা নমুনা/ভিডিও.mp4" },
    { "do": "waitFor", "probe": "frame.size", "eq": "640x360", "timeout": 10000 },
    { "do": "expect", "probe": "status.source", "contains": "ভিডিও.mp4" },
    { "do": "open", "file": "samples/alpha-vp9.webm" },
    { "do": "waitFor", "probe": "video.codec", "eq": "vp9", "timeout": 10000 },
    { "do": "wait", "ms": 500 },
    { "do": "expect", "probe": "video.hardware", "eq": false },
    { "do": "expect", "probe": "status.source", "contains": "alpha" },
    { "do": "open", "file": "samples/hdr-pq.mkv" },
    { "do": "waitFor", "probe": "video.codec", "eq": "hevc", "timeout": 10000 },
    { "do": "wait", "ms": 600 },
    { "do": "expect", "probe": "status.source", "contains": "HDR → SDR" },
    { "do": "shot", "file": "open-hdr.png", "maxWidth": 1600 }
  ]
}
