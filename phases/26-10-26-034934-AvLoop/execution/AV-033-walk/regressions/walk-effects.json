{
  "delay": 120,
  "settle": 700,
  "steps": [
    { "label": "the Clip effects section: none set, the canvas as the video is" },
    { "do": "open", "file": "samples/counter-640p30.mp4" },
    { "do": "waitFor", "probe": "video.state", "eq": "ready", "timeout": 10000 },
    { "do": "wait", "ms": 300 },
    { "do": "expect", "probe": "effects.summary", "eq": "" },
    { "do": "expect", "probe": "effects.on", "eq": true },
    { "do": "shot", "on": "CanvasArea", "file": "canvas-none.png", "maxWidth": 1000 },

    { "label": "a look typed field by field: each one Undo step, the canvas follows at once" },
    { "do": "type", "on": "panel.effects.exposure", "text": "0.6" },
    { "do": "type", "on": "panel.effects.contrast", "text": "20" },
    { "do": "type", "on": "panel.effects.temperature", "text": "40" },
    { "do": "type", "on": "panel.effects.vibrance", "text": "50" },
    { "do": "type", "on": "panel.effects.vignette", "text": "60" },
    { "do": "type", "on": "panel.effects.sharpen", "text": "30" },
    { "do": "type", "on": "panel.effects.hue", "text": "-150" },
    { "do": "expect", "probe": "effects.summary",
      "eq": "contrast=20 exposure=0.6 hue=-150 sharpen=30 temperature=40 vibrance=50 vignette=60" },
    { "do": "expect", "probe": "undo.count", "eq": 7 },
    { "do": "shot", "on": "CanvasArea", "file": "canvas-look.png", "maxWidth": 1000 },
    { "do": "shot", "on": "Section.effects", "file": "panel-effects.png" },

    { "label": "Invert, Posterize, Blur, Opacity: the checkerboard shows through" },
    { "do": "click", "on": "panel.effects.invert" },
    { "do": "type", "on": "panel.effects.posterize", "text": "4" },
    { "do": "type", "on": "panel.effects.blur", "text": "8" },
    { "do": "type", "on": "panel.effects.opacity", "text": "60" },
    { "do": "expect", "probe": "effects.summary",
      "eq": "blur=8 contrast=20 exposure=0.6 hue=-150 invert=1 opacity=60 posterize=4 sharpen=30 temperature=40 vibrance=50 vignette=60" },
    { "do": "shot", "on": "CanvasArea", "file": "canvas-creative.png", "maxWidth": 1000 },
    { "do": "shot", "on": "Section.effects", "file": "panel-effects-creative.png" },

    { "label": "Undo takes the last field back; Off shows the clip as it is, the values kept" },
    { "do": "key", "keys": "Ctrl+Z", "on": "MainWindow" },
    { "do": "expect", "probe": "effects.summary", "lacks": "opacity=" },
    { "do": "click", "on": "panel.effects.on" },
    { "do": "expect", "probe": "effects.on", "eq": false },
    { "do": "expect", "probe": "effects.summary", "contains": "invert=1" },
    { "do": "shot", "on": "CanvasArea", "file": "canvas-off.png", "maxWidth": 1000 },
    { "do": "click", "on": "panel.effects.on" },
    { "do": "expect", "probe": "effects.on", "eq": true },

    { "label": "the Preview shows the exact output with the effects" },
    { "do": "key", "keys": "F5", "on": "MainWindow" },
    { "do": "waitFor", "probe": "preview.frame", "eq": "640x360", "timeout": 10000 },
    { "do": "wait", "ms": 800 },
    { "do": "shot", "on": "PreviewWindow", "file": "preview-effects.png", "maxWidth": 1000 },

    { "label": "Reset: none, one Undo step" },
    { "do": "click", "on": "panel.effects.reset" },
    { "do": "expect", "probe": "effects.summary", "eq": "" },
    { "do": "key", "keys": "Ctrl+Z", "on": "MainWindow" },
    { "do": "expect", "probe": "effects.summary", "contains": "invert=1" }
  ]
}
