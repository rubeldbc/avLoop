{
  "delay": 120,
  "settle": 700,
  "steps": [
    { "label": "D-026: three rectangles drawn with S at 100 % (a canvas point lands ½ px in)" },
    { "do": "open", "file": "samples/counter-640p30.mp4" },
    { "do": "waitFor", "probe": "video.state", "eq": "ready", "timeout": 10000 },
    { "do": "wait", "ms": 300 },
    { "do": "key", "keys": "Ctrl+1", "on": "MainWindow" },
    { "do": "key", "keys": "S", "on": "MainWindow" },
    { "do": "drag", "on": "canvas", "space": "canvas", "from": [20, 20], "to": [80, 80], "steps": 8 },
    { "do": "key", "keys": "Escape", "on": "canvas" },
    { "do": "drag", "on": "canvas", "space": "canvas", "from": [200, 100], "to": [260, 180], "steps": 8 },
    { "do": "key", "keys": "Escape", "on": "canvas" },
    { "do": "drag", "on": "canvas", "space": "canvas", "from": [420, 40], "to": [500, 120], "steps": 8 },
    { "do": "expect", "probe": "shapes.count", "eq": 3 },
    { "do": "shot", "on": "canvas", "file": "canvas-before.png", "maxWidth": 1200 },

    { "label": "Ctrl+A; Align left: all at A's left, none resized; Undo" },
    { "do": "key", "keys": "Ctrl+A", "on": "canvas" },
    { "do": "click", "on": "options.shape.align.left" },
    { "do": "expect", "probe": "shapes.summary", "eq": "rect:add:21,20,60,60;rect:add:21,100,60,80;rect:add:21,40,80,80" },
    { "do": "key", "keys": "Ctrl+Z", "on": "MainWindow" },

    { "label": "Distribute horizontally: the middle one's gaps equal (B at 220.5); Undo" },
    { "do": "click", "on": "options.shape.spreadH" },
    { "do": "expect", "probe": "shapes.summary", "contains": ";rect:add:221,100,60,80;" },
    { "do": "shot", "on": "canvas", "file": "canvas-distributed.png", "maxWidth": 1200 },
    { "do": "key", "keys": "Ctrl+Z", "on": "MainWindow" },

    { "label": "one shape, To: Frame — centred on the video both ways" },
    { "do": "key", "keys": "Escape", "on": "canvas" },
    { "do": "click", "on": "canvas", "space": "canvas", "at": [230, 140] },
    { "do": "expect", "probe": "shapes.selected", "eq": "1" },
    { "do": "choose", "on": "options.shape.alignTo", "data": 1 },
    { "do": "click", "on": "options.shape.align.centre" },
    { "do": "click", "on": "options.shape.align.middle" },
    { "do": "expect", "probe": "shapes.summary", "contains": ";rect:add:290,140,60,80;" },
    { "do": "choose", "on": "options.shape.alignTo", "data": 0 },

    { "label": "the layers: rename, duplicate, Up, hide, lock" },
    { "do": "type", "on": "panel.shapes.name", "text": "Window" },
    { "do": "expect", "probe": "panel.shapes.rows", "contains": "Window · Select" },
    { "do": "click", "on": "panel.shapes.duplicate" },
    { "do": "expect", "probe": "shapes.count", "eq": 4 },
    { "do": "expect", "probe": "shapes.selected", "eq": "2" },
    { "do": "expect", "probe": "panel.shapes.rows", "contains": "Window copy · Select" },
    { "do": "click", "on": "panel.shapes.up" },
    { "do": "expect", "probe": "shapes.selected", "eq": "3" },
    { "do": "expect", "probe": "panel.shapes.rows", "contains": "Window copy · Select|Rectangle 3" },
    { "do": "click", "on": "panel.shapes.visible" },
    { "do": "expect", "probe": "shapes.flags", "eq": "vu,vu,vu,hu" },
    { "do": "click", "on": "canvas", "space": "canvas", "at": [50, 50] },
    { "do": "expect", "probe": "shapes.selected", "eq": "0" },
    { "do": "click", "on": "panel.shapes.locked" },
    { "do": "expect", "probe": "shapes.flags", "eq": "vl,vu,vu,hu" },
    { "do": "key", "keys": "Escape", "on": "canvas" },
    { "do": "click", "on": "canvas", "space": "canvas", "at": [50, 50] },
    { "do": "expect", "probe": "shapes.selected", "eq": "" },
    { "do": "shot", "on": "canvas", "file": "canvas-layers.png", "maxWidth": 1200 },
    { "do": "shot", "on": "Section.crop", "file": "panel-layers.png" },

    { "label": "Undo through them: unlocked, shown, down again, one copy fewer, the old name" },
    { "do": "key", "keys": "Ctrl+Z", "on": "MainWindow" },
    { "do": "expect", "probe": "shapes.flags", "eq": "vu,vu,vu,hu" },
    { "do": "key", "keys": "Ctrl+Z", "on": "MainWindow" },
    { "do": "key", "keys": "Ctrl+Z", "on": "MainWindow" },
    { "do": "key", "keys": "Ctrl+Z", "on": "MainWindow" },
    { "do": "expect", "probe": "shapes.count", "eq": 3 },
    { "do": "key", "keys": "Ctrl+Z", "on": "MainWindow" },
    { "do": "expect", "probe": "panel.shapes.rows", "lacks": "Window" }
  ]
}
