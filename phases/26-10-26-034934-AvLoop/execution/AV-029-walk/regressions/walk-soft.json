{
  "delay": 120,
  "settle": 700,
  "steps": [
    { "label": "D-024: a rectangle that selects and an ellipse that cuts inside it, with S at 100 %" },
    { "do": "open", "file": "samples/counter-640p30.mp4" },
    { "do": "waitFor", "probe": "video.state", "eq": "ready", "timeout": 10000 },
    { "do": "wait", "ms": 300 },
    { "do": "key", "keys": "Ctrl+1", "on": "MainWindow" },
    { "do": "key", "keys": "S", "on": "MainWindow" },
    { "do": "drag", "on": "canvas", "space": "canvas", "from": [60, 40], "to": [580, 320], "steps": 12 },
    { "do": "key", "keys": "Escape", "on": "canvas" },
    { "do": "choose", "on": "options.shape.kind", "data": 2 },
    { "do": "choose", "on": "options.shape.role", "data": 1 },
    { "do": "expect", "probe": "shapes.count", "eq": 1 },
    { "do": "expect", "probe": "shapes.selected", "eq": "" },
    { "do": "expect", "probe": "shapes.soft", "eq": "0/100" },

    { "label": "the cut ellipse is drawn outside the rectangle's start point, then moved in by its bar" },
    { "do": "drag", "on": "canvas", "space": "canvas", "from": [590, 20], "to": [630, 60], "steps": 8 },
    { "do": "expect", "probe": "shapes.count", "eq": 2 },
    { "do": "type", "on": "options.shape.x", "text": "220" },
    { "do": "type", "on": "options.shape.y", "text": "100" },
    { "do": "type", "on": "options.shape.w", "text": "200" },
    { "do": "type", "on": "options.shape.h", "text": "160" },
    { "do": "expect", "probe": "shapes.summary", "contains": ";ellipse:cut:220,100,200,160" },

    { "label": "Strength 40 and Feather 30 on the bar: the list says so; one Undo step each" },
    { "do": "type", "on": "options.shape.strength", "text": "40" },
    { "do": "expect", "probe": "shapes.soft", "eq": "0/100;0/40" },
    { "do": "type", "on": "options.shape.feather", "text": "30" },
    { "do": "expect", "probe": "shapes.soft", "eq": "0/100;30/40" },
    { "do": "expect", "probe": "panel.shapes.rows", "contains": "Ellipse 1 · Cut · 30 px · 40 %" },
    { "do": "shot", "on": "canvas", "file": "canvas-soft.png", "maxWidth": 1200 },
    { "do": "shot", "on": "Section.crop", "file": "panel-soft.png" },
    { "do": "key", "keys": "F5", "on": "MainWindow" },
    { "do": "waitFor", "probe": "preview.frame", "eq": "640x360", "timeout": 10000 },
    { "do": "wait", "ms": 800 },
    { "do": "shot", "on": "PreviewWindow", "file": "preview-soft.png", "maxWidth": 1000 },
    { "do": "previewClose" },
    { "do": "key", "keys": "Ctrl+Z", "on": "MainWindow" },
    { "do": "expect", "probe": "shapes.soft", "eq": "0/100;0/40" },

    { "label": "the Crop section's Strength 100; then both shapes selected, one Feather typed sets both" },
    { "do": "type", "on": "panel.shapes.strength", "text": "100" },
    { "do": "expect", "probe": "shapes.soft", "eq": "0/100;0/100" },
    { "do": "key", "keys": "Ctrl+A", "on": "canvas" },
    { "do": "expect", "probe": "shapes.selected", "eq": "0,1" },
    { "do": "type", "on": "panel.shapes.feather", "text": "12" },
    { "do": "expect", "probe": "shapes.soft", "eq": "12/100;12/100" }
  ]
}
