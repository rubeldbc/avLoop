{
  "delay": 120,
  "settle": 700,
  "steps": [
    { "label": "S6/S7/S8: the Loop panel on a 5 s range (In 2 s, Out 7 s) of the 30 fps counter" },
    { "do": "open", "file": "samples/counter-640p30.mp4" },
    { "do": "waitFor", "probe": "video.state", "eq": "ready", "timeout": 10000 },
    { "do": "type", "on": "transport.time", "text": "2" },
    { "do": "key", "keys": "I", "on": "MainWindow" },
    { "do": "type", "on": "transport.time", "text": "6.9667" },
    { "do": "key", "keys": "O", "on": "MainWindow" },
    { "do": "expect", "probe": "range.out", "near": [7, 0.001] },
    { "do": "expect", "probe": "loop.mode", "eq": "crossfade" },
    { "do": "expect", "probe": "loop.plan", "eq": "D150 F15 T9 L135" },
    { "do": "expect", "probe": "panel.loop.summary", "eq": "Loop 4.50 s · 135 frames @ 30 fps" },

    { "label": "the four modes: L = D, D − F, 2D − 2, 2D − 2" },
    { "do": "choose", "on": "panel.loop.mode", "data": 0 },
    { "do": "expect", "probe": "panel.loop.summary", "eq": "Loop 5.00 s · 150 frames @ 30 fps" },
    { "do": "choose", "on": "panel.loop.mode", "data": 2 },
    { "do": "expect", "probe": "panel.loop.summary", "eq": "Loop 9.93 s · 298 frames @ 30 fps" },
    { "do": "choose", "on": "panel.loop.mode", "data": 3 },
    { "do": "expect", "probe": "loop.mode", "eq": "pingpong-smooth" },
    { "do": "expect", "probe": "panel.loop.summary", "eq": "Loop 9.93 s · 298 frames @ 30 fps" },
    { "do": "shot", "file": "loop-smooth-turn.png", "maxWidth": 1600 },
    { "do": "choose", "on": "panel.loop.mode", "data": 1 },
    { "do": "expect", "probe": "loop.mode", "eq": "crossfade" },

    { "label": "Crossfade in frames and in seconds, linked; beyond half the segment it is clamped and flashes" },
    { "do": "type", "on": "panel.loop.fadeFrames", "text": "30" },
    { "do": "expect", "probe": "loop.plan", "eq": "D150 F30 T9 L120" },
    { "do": "expect", "probe": "panel.loop.summary", "eq": "Loop 4.00 s · 120 frames @ 30 fps" },
    { "do": "type", "on": "panel.loop.fade", "text": "10" },
    { "do": "expect", "probe": "loop.plan", "eq": "D150 F75 T9 L75" },
    { "do": "expect", "probe": "panel.loop.fadeFlash", "eq": true },
    { "do": "type", "on": "panel.loop.fade", "text": "0.5" },
    { "do": "expect", "probe": "loop.plan", "eq": "D150 F15 T9 L135" },

    { "label": "the crossfade band: its left edge dragged one second sets F (one Undo step)" },
    { "do": "expect", "probe": "timeline.fadeEdge", "near": [6.5, 0.001] },
    { "do": "shot", "on": "TimelineArea", "file": "band-before.png" },
    { "do": "drag", "on": "timeline", "space": "timeline", "from": [6.5, 84], "to": [6.0, 84], "steps": 12 },
    { "do": "expect", "probe": "loop.plan", "eq": "D150 F30 T9 L120" },
    { "do": "expect", "probe": "timeline.fadeEdge", "near": [6.0, 0.001] },
    { "do": "shot", "on": "TimelineArea", "file": "band-after.png" },
    { "do": "key", "keys": "Ctrl+Z", "on": "MainWindow" },
    { "do": "expect", "probe": "loop.plan", "eq": "D150 F15 T9 L135" },
    { "do": "key", "keys": "Ctrl+Y", "on": "MainWindow" },
    { "do": "expect", "probe": "loop.plan", "eq": "D150 F30 T9 L120" },

    { "label": "Speed 0.5: twice the frames; with Nearest the slow-motion hint; Motion Interpolation drops it" },
    { "do": "type", "on": "panel.loop.speed", "text": "0.5" },
    { "do": "expect", "probe": "loop.speed", "eq": 0.5 },
    { "do": "expect", "probe": "loop.plan", "eq": "D300 F30 T9 L270" },
    { "do": "expect", "probe": "panel.loop.slowHint", "eq": true },
    { "do": "choose", "on": "panel.loop.method", "data": 2 },
    { "do": "expect", "probe": "panel.loop.slowHint", "eq": false },
    { "do": "shot", "file": "loop-panel.png", "maxWidth": 1600 },

    { "label": "the output frame rate: 60, 25 (In and Out kept in seconds), Undo, Source, Custom" },
    { "do": "choose", "on": "panel.output.fps", "data": "60/1" },
    { "do": "expect", "probe": "output.fps", "eq": "60" },
    { "do": "expect", "probe": "panel.loop.summary", "eq": "Loop 9.00 s · 540 frames @ 60 fps" },
    { "do": "choose", "on": "panel.output.fps", "data": "25/1" },
    { "do": "expect", "probe": "panel.loop.summary", "eq": "Loop 9.00 s · 225 frames @ 25 fps" },
    { "do": "expect", "probe": "range.in", "near": [2, 0.001] },
    { "do": "expect", "probe": "range.out", "near": [7, 0.001] },
    { "do": "key", "keys": "Ctrl+Z", "on": "MainWindow" },
    { "do": "expect", "probe": "output.fps", "eq": "60" },
    { "do": "choose", "on": "panel.output.fps", "data": "source" },
    { "do": "expect", "probe": "output.fps", "eq": "30" },
    { "do": "choose", "on": "panel.output.fps", "data": "custom" },
    { "do": "type", "on": "panel.output.fpsCustom", "text": "47.952" },
    { "do": "expect", "probe": "output.fps", "eq": "47.952" },
    { "do": "choose", "on": "panel.output.fps", "data": "source" },

    { "label": "playback at Speed 0.5: a second of play moves half a second of source" },
    { "do": "key", "keys": "Home", "on": "MainWindow" },
    { "do": "expect", "probe": "playhead", "near": [2, 0.001] },
    { "do": "key", "keys": "Space", "on": "MainWindow" },
    { "do": "wait", "ms": 1000 },
    { "do": "key", "keys": "Space", "on": "MainWindow" },
    { "do": "expect", "probe": "playhead", "near": [2.5, 0.12] },
    { "do": "expect", "probe": "playback.dropped", "eq": 0 }
  ]
}
