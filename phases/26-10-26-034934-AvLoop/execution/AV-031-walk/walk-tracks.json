{
  "delay": 120,
  "settle": 700,
  "steps": [
    { "label": "D-027 (AV-031): the counter; a layer — one lane, V2, its bar 0 … 10 s" },
    { "do": "open", "file": "samples/counter-640p30.mp4" },
    { "do": "waitFor", "probe": "video.state", "eq": "ready", "timeout": 10000 },
    { "do": "wait", "ms": 300 },
    { "do": "key", "keys": "Ctrl+1", "on": "MainWindow" },
    { "do": "expect", "probe": "lanes.tracks", "eq": 0 },
    { "do": "addLayer", "file": "samples/counter-640p30.mp4" },
    { "do": "expect", "probe": "lanes.tracks", "eq": 1 },
    { "do": "expect", "probe": "layers.track", "eq": 2 },

    { "label": "its right end trimmed to 6 s; its body moved 2 s later; its left end trimmed 1 s (the start goes with it)" },
    { "do": "drag", "on": "lanes", "space": "lanes", "from": [9.98, 2], "to": [6, 2], "steps": 12 },
    { "do": "expect", "probe": "layers.out", "near": [6, 0.05] },
    { "do": "drag", "on": "lanes", "space": "lanes", "from": [3, 2], "to": [5, 2], "steps": 12 },
    { "do": "expect", "probe": "layers.start", "near": [2, 0.05] },
    { "do": "drag", "on": "lanes", "space": "lanes", "from": [2.0, 2], "to": [3, 2], "steps": 12 },
    { "do": "expect", "probe": "layers.start", "near": [3, 0.05] },
    { "do": "expect", "probe": "layers.in", "near": [1, 0.05] },
    { "do": "expect", "probe": "undo.count", "eq": 4 },

    { "label": "a second layer from the playhead overlaps on V2: it goes to V3; dragged down it is refused" },
    { "do": "addLayer", "file": "samples/counter-640p30.mp4" },
    { "do": "expect", "probe": "layers.track", "eq": 3 },
    { "do": "expect", "probe": "lanes.tracks", "eq": 2 },
    { "do": "drag", "on": "lanes", "space": "lanes", "from": [1, 3], "to": [1, 2], "steps": 8 },
    { "do": "expect", "probe": "layers.track", "eq": 3 },

    { "label": "Alt+drag copies the first up to V4; Delete removes the copy" },
    { "do": "drag", "on": "lanes", "space": "lanes", "from": [5, 2], "to": [5, 4], "steps": 8, "mods": "Alt" },
    { "do": "expect", "probe": "layers.count", "eq": 3 },
    { "do": "expect", "probe": "layers.track", "eq": 4 },
    { "do": "shot", "on": "TimelineArea", "file": "timeline-tracks.png", "maxWidth": 1400 },
    { "do": "key", "keys": "Delete", "on": "lanes" },
    { "do": "expect", "probe": "layers.count", "eq": 2 },

    { "label": "the canvas: the Selection picks the layer showing at the playhead and moves it" },
    { "do": "key", "keys": "V", "on": "MainWindow" },
    { "do": "click", "on": "canvas", "space": "canvas", "at": [300, 200] },
    { "do": "expect", "probe": "layers.selected", "eq": 1 },
    { "do": "drag", "on": "canvas", "space": "canvas", "from": [300, 200], "to": [350, 220], "steps": 10 },
    { "do": "expect", "probe": "layers.summary", "contains": ":V3:0.00:370,200,100:100" },
    { "do": "expect", "probe": "transform.x", "near": [320, 0.01] },
    { "do": "wait", "ms": 500 },
    { "do": "shot", "on": "canvas", "file": "canvas-tracks.png", "maxWidth": 1200 },

    { "label": "Undo: the move, the delete, the copy, the second layer, the trims" },
    { "do": "key", "keys": "Ctrl+Z", "on": "MainWindow" },
    { "do": "expect", "probe": "layers.summary", "contains": ":V3:0.00:320,180,100:100" },
    { "do": "key", "keys": "Ctrl+Z", "on": "MainWindow" },
    { "do": "expect", "probe": "layers.count", "eq": 3 },
    { "do": "key", "keys": "Ctrl+Z", "on": "MainWindow" },
    { "do": "key", "keys": "Ctrl+Z", "on": "MainWindow" },
    { "do": "expect", "probe": "layers.count", "eq": 1 },
    { "do": "key", "keys": "Ctrl+Z", "on": "MainWindow" },
    { "do": "key", "keys": "Ctrl+Z", "on": "MainWindow" },
    { "do": "key", "keys": "Ctrl+Z", "on": "MainWindow" },
    { "do": "expect", "probe": "layers.summary", "contains": ":V2:0.00:" }
  ]
}
