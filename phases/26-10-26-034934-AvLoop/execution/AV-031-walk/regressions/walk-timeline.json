{
  "delay": 120,
  "settle": 700,
  "steps": [
    { "label": "S6: the timeline of a 10 s 1080p30 video — the whole file, the playhead at 0" },
    { "do": "open", "file": "samples/counter-1080p30.mp4" },
    { "do": "waitFor", "probe": "video.state", "eq": "ready", "timeout": 10000 },
    { "do": "wait", "ms": 600 },
    { "do": "expect", "probe": "range.in", "eq": 0 },
    { "do": "expect", "probe": "range.out", "near": [10, 0.001] },
    { "do": "expect", "probe": "playhead", "eq": 0 },
    { "do": "expect", "probe": "transport.time", "eq": "00:00:00.00" },
    { "do": "expect", "probe": "range.text", "contains": "(300 f)" },
    { "do": "expect", "probe": "timeline.labels", "eq": "timecode" },
    { "do": "expect", "probe": "timeline.overlaps", "eq": 0 },
    { "do": "shot", "file": "timeline-start.png", "maxWidth": 1600 },

    { "label": "a click on the strip scrubs there; the canvas shows that exact frame" },
    { "do": "click", "on": "timeline", "space": "timeline", "at": [2.5167, 50] },
    { "do": "waitFor", "probe": "frame.seconds", "near": [2.5, 0.001], "timeout": 3000 },
    { "do": "expect", "probe": "playhead", "near": [2.5, 0.001] },
    { "do": "expect", "probe": "transport.time", "eq": "00:00:02.15" },

    { "label": "I and O at the playhead (O keeps the frame under it); arrows step 1, Shift 10; Home/End; Ctrl+Home/End" },
    { "do": "key", "keys": "I", "on": "MainWindow" },
    { "do": "expect", "probe": "range.in", "near": [2.5, 0.001] },
    { "do": "key", "keys": "Right", "on": "MainWindow" },
    { "do": "key", "keys": "Right", "on": "MainWindow" },
    { "do": "key", "keys": "Right", "on": "MainWindow" },
    { "do": "expect", "probe": "playhead", "near": [2.6, 0.001] },
    { "do": "waitFor", "probe": "frame.seconds", "near": [2.6, 0.001], "timeout": 3000 },
    { "do": "key", "keys": "Shift+Right", "on": "MainWindow" },
    { "do": "expect", "probe": "playhead", "near": [2.9333, 0.001] },
    { "do": "key", "keys": "O", "on": "MainWindow" },
    { "do": "expect", "probe": "range.out", "near": [2.9667, 0.001] },
    { "do": "expect", "probe": "range.text", "contains": "(14 f)" },
    { "do": "key", "keys": "Home", "on": "MainWindow" },
    { "do": "expect", "probe": "playhead", "near": [2.5, 0.001] },
    { "do": "key", "keys": "End", "on": "MainWindow" },
    { "do": "expect", "probe": "playhead", "near": [2.9333, 0.001] },
    { "do": "key", "keys": "Left", "on": "MainWindow" },
    { "do": "expect", "probe": "playhead", "near": [2.9, 0.001] },
    { "do": "key", "keys": "Ctrl+End", "on": "MainWindow" },
    { "do": "expect", "probe": "playhead", "near": [9.9667, 0.001] },
    { "do": "waitFor", "probe": "frame.seconds", "near": [9.9667, 0.001], "timeout": 3000 },
    { "do": "key", "keys": "Ctrl+Home", "on": "MainWindow" },
    { "do": "expect", "probe": "playhead", "eq": 0 },
    { "do": "key", "keys": "Alt+I", "on": "MainWindow" },
    { "do": "expect", "probe": "range.in", "eq": 0 },
    { "do": "key", "keys": "Alt+O", "on": "MainWindow" },
    { "do": "expect", "probe": "range.out", "near": [10, 0.001] },
    { "do": "expect", "probe": "undo.count", "eq": 4 },

    { "label": "In after Out moves Out to the file's end; Out before In moves In to the start" },
    { "do": "type", "on": "transport.time", "text": "8" },
    { "do": "expect", "probe": "playhead", "near": [8, 0.001] },
    { "do": "key", "keys": "O", "on": "MainWindow" },
    { "do": "expect", "probe": "range.out", "near": [8.0333, 0.001] },
    { "do": "type", "on": "transport.time", "text": "9" },
    { "do": "key", "keys": "I", "on": "MainWindow" },
    { "do": "expect", "probe": "range.in", "near": [9, 0.001] },
    { "do": "expect", "probe": "range.out", "near": [10, 0.001] },
    { "do": "type", "on": "transport.time", "text": "1" },
    { "do": "key", "keys": "O", "on": "MainWindow" },
    { "do": "expect", "probe": "range.in", "eq": 0 },
    { "do": "expect", "probe": "range.out", "near": [1.0333, 0.001] },

    { "label": "the In and Out tools: a click on the timeline sets them there; Out's time typed" },
    { "do": "click", "on": "tool.in" },
    { "do": "expect", "probe": "tool.active", "eq": "in" },
    { "do": "click", "on": "timeline", "space": "timeline", "at": [4.0167, 50] },
    { "do": "expect", "probe": "range.in", "near": [4, 0.001] },
    { "do": "expect", "probe": "range.out", "near": [10, 0.001] },
    { "do": "expect", "probe": "playhead", "near": [4, 0.001] },
    { "do": "click", "on": "tool.out" },
    { "do": "click", "on": "timeline", "space": "timeline", "at": [6.0167, 50] },
    { "do": "expect", "probe": "range.out", "near": [6.0333, 0.001] },
    { "do": "expect", "probe": "options.out.length", "contains": "61 frames" },
    { "do": "type", "on": "options.out.time", "text": "7" },
    { "do": "expect", "probe": "range.out", "near": [7, 0.001] },
    { "do": "key", "keys": "V", "on": "MainWindow" },

    { "label": "a handle drags In (the canvas shows that frame); the bar moves the range; Undo and Redo" },
    { "do": "drag", "on": "timeline", "space": "timeline", "from": [4, 50], "to": [3, 50], "steps": 12 },
    { "do": "expect", "probe": "range.in", "near": [3, 0.001] },
    { "do": "waitFor", "probe": "frame.seconds", "near": [3, 0.001], "timeout": 3000 },
    { "do": "drag", "on": "timeline", "space": "timeline", "from": [5, 22], "to": [6, 22], "steps": 12 },
    { "do": "expect", "probe": "range.in", "near": [4, 0.001] },
    { "do": "expect", "probe": "range.out", "near": [8, 0.001] },
    { "do": "key", "keys": "Ctrl+Z", "on": "MainWindow" },
    { "do": "expect", "probe": "range.in", "near": [3, 0.001] },
    { "do": "expect", "probe": "range.out", "near": [7, 0.001] },
    { "do": "key", "keys": "Ctrl+Z", "on": "MainWindow" },
    { "do": "expect", "probe": "range.in", "near": [4, 0.001] },
    { "do": "key", "keys": "Ctrl+Y", "on": "MainWindow" },
    { "do": "expect", "probe": "range.in", "near": [3, 0.001] },

    { "label": "zoom: Ctrl+wheel about the pointer down to 12 px a frame — labels never overlap (five pictures)" },
    { "do": "shot", "on": "TimelineArea", "file": "zoom-1-fit.png" },
    { "do": "wheel", "on": "timeline", "space": "timeline", "at": [5, 50], "delta": 120, "mods": "Ctrl" },
    { "do": "expect", "probe": "timeline.overlaps", "eq": 0 },
    { "do": "shot", "on": "TimelineArea", "file": "zoom-2.png" },
    { "do": "wheel", "on": "timeline", "space": "timeline", "at": [5, 50], "delta": 360, "mods": "Ctrl" },
    { "do": "expect", "probe": "timeline.overlaps", "eq": 0 },
    { "do": "shot", "on": "TimelineArea", "file": "zoom-3.png" },
    { "do": "wheel", "on": "timeline", "space": "timeline", "at": [5, 50], "delta": 1200, "mods": "Ctrl" },
    { "do": "expect", "probe": "timeline.pxPerSecond", "eq": 360 },
    { "do": "expect", "probe": "timeline.overlaps", "eq": 0 },
    { "do": "shot", "on": "TimelineArea", "file": "zoom-4-max.png" },
    { "do": "dclick", "on": "timeline", "space": "timeline", "at": [5, 8] },
    { "do": "expect", "probe": "timeline.labels", "eq": "frames" },
    { "do": "expect", "probe": "timeline.overlaps", "eq": 0 },
    { "do": "shot", "on": "TimelineArea", "file": "zoom-5-max-frames.png" },
    { "do": "key", "keys": "\\", "on": "MainWindow" },
    { "do": "expect", "probe": "timeline.pxPerSecond", "max": 200 },
    { "do": "expect", "probe": "timeline.overlaps", "eq": 0 },
    { "do": "key", "keys": "Shift+\\", "on": "MainWindow" },
    { "do": "expect", "probe": "timeline.pxPerSecond", "min": 200 },
    { "do": "dclick", "on": "timeline", "space": "timeline", "at": [5, 8] },
    { "do": "expect", "probe": "timeline.labels", "eq": "timecode" },
    { "do": "key", "keys": "\\", "on": "MainWindow" },

    { "label": "the transport: a frame typed, Next, Prev, Go to In, Go to Out" },
    { "do": "type", "on": "transport.time", "text": "150f" },
    { "do": "expect", "probe": "playhead", "near": [5, 0.001] },
    { "do": "waitFor", "probe": "frame.seconds", "near": [5, 0.001], "timeout": 3000 },
    { "do": "click", "on": "transport.next" },
    { "do": "expect", "probe": "playhead", "near": [5.0333, 0.001] },
    { "do": "click", "on": "transport.prev" },
    { "do": "expect", "probe": "playhead", "near": [5, 0.001] },
    { "do": "click", "on": "transport.goIn" },
    { "do": "expect", "probe": "playhead", "near": [3, 0.001] },
    { "do": "click", "on": "transport.goOut" },
    { "do": "expect", "probe": "playhead", "near": [6.9667, 0.001] },

    { "label": "Space plays — loop on, round In → Out — and pauses; no frame dropped" },
    { "do": "key", "keys": "Space", "on": "MainWindow" },
    { "do": "expect", "probe": "playback.playing", "eq": true },
    { "do": "wait", "ms": 2500 },
    { "do": "key", "keys": "Space", "on": "MainWindow" },
    { "do": "expect", "probe": "playback.playing", "eq": false },
    { "do": "expect", "probe": "playback.dropped", "eq": 0 },
    { "do": "expect", "probe": "playback.shown", "min": 60 },
    { "do": "expect", "probe": "playhead", "min": 3 },
    { "do": "expect", "probe": "playhead", "max": 7 },
    { "do": "key", "keys": "L", "on": "MainWindow" },
    { "do": "expect", "probe": "playback.loop", "eq": false },
    { "do": "key", "keys": "L", "on": "MainWindow" },
    { "do": "expect", "probe": "playback.loop", "eq": true },

    { "label": "arrows on the canvas: the crop's nudge with a crop tool, a frame step with the Selection" },
    { "do": "type", "on": "transport.time", "text": "4" },
    { "do": "key", "keys": "M", "on": "MainWindow" },
    { "do": "drag", "on": "canvas", "space": "canvas", "from": [400, 200], "to": [800, 500], "steps": 12 },
    { "do": "expect", "probe": "crop.x", "near": [400, 2] },
    { "do": "key", "keys": "Right", "on": "canvas" },
    { "do": "expect", "probe": "crop.x", "near": [401, 2] },
    { "do": "expect", "probe": "playhead", "near": [4, 0.001] },
    { "do": "key", "keys": "V", "on": "MainWindow" },
    { "do": "key", "keys": "Right", "on": "canvas" },
    { "do": "expect", "probe": "playhead", "near": [4.0333, 0.001] },
    { "do": "expect", "probe": "crop.x", "near": [401, 2] },

    { "label": "the thumbnails made on their own decoder" },
    { "do": "waitFor", "probe": "timeline.overlaps", "eq": 0 },
    { "do": "expect", "probe": "timeline.thumbs", "min": 20 },
    { "do": "shot", "file": "timeline-end.png", "maxWidth": 1600 }
  ]
}
