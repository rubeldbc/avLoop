{
  "delay": 120,
  "settle": 700,
  "steps": [
    { "label": "D-027: the counter; Add as layer… the counter again — on V2 from the playhead, selected" },
    { "do": "open", "file": "samples/counter-640p30.mp4" },
    { "do": "waitFor", "probe": "video.state", "eq": "ready", "timeout": 10000 },
    { "do": "wait", "ms": 300 },
    { "do": "key", "keys": "Ctrl+1", "on": "MainWindow" },
    { "do": "expect", "probe": "layers.count", "eq": 0 },
    { "do": "addLayer", "file": "samples/counter-640p30.mp4" },
    { "do": "expect", "probe": "layers.count", "eq": 1 },
    { "do": "expect", "probe": "layers.selected", "eq": 0 },
    { "do": "expect", "probe": "layers.summary", "eq": "counter-640p30:V2:0.00:320,180,100:100" },
    { "do": "expect", "probe": "undo.count", "eq": 1 },

    { "label": "the Layers section: Scale 50, X 160, Y 90, Opacity 60 — one Undo step each" },
    { "do": "type", "on": "panel.layers.scale", "text": "50" },
    { "do": "type", "on": "panel.layers.x", "text": "160" },
    { "do": "type", "on": "panel.layers.y", "text": "90" },
    { "do": "type", "on": "panel.layers.opacity", "text": "60" },
    { "do": "expect", "probe": "layers.summary", "eq": "counter-640p30:V2:0.00:160,90,50:60" },
    { "do": "expect", "probe": "undo.count", "eq": 5 },
    { "do": "wait", "ms": 600 },
    { "do": "shot", "on": "canvas", "file": "canvas-layer.png", "maxWidth": 1200 },
    { "do": "shot", "on": "Section.layers", "file": "panel-layers.png" },

    { "label": "the Preview: the layer over the main video, exactly" },
    { "do": "key", "keys": "F5", "on": "MainWindow" },
    { "do": "waitFor", "probe": "preview.frame", "eq": "640x360", "timeout": 10000 },
    { "do": "wait", "ms": 800 },
    { "do": "shot", "on": "PreviewWindow", "file": "preview-layer.png", "maxWidth": 1000 },
    { "do": "previewClose" },

    { "label": "a second layer at the same time goes to V3; Reset Layers removes both; Undo gives them back" },
    { "do": "addLayer", "file": "samples/counter-640p30.mp4" },
    { "do": "expect", "probe": "layers.count", "eq": 2 },
    { "do": "expect", "probe": "layers.summary", "contains": ";counter-640p30:V3:" },
    { "do": "click", "on": "panel.layers.delete" },
    { "do": "expect", "probe": "layers.count", "eq": 1 },
    { "do": "context", "on": "Section.layers", "path": ["Reset Layers"] },
    { "do": "expect", "probe": "layers.count", "eq": 0 },
    { "do": "key", "keys": "Ctrl+Z", "on": "MainWindow" },
    { "do": "expect", "probe": "layers.count", "eq": 1 },
    { "do": "key", "keys": "Ctrl+Z", "on": "MainWindow" },
    { "do": "expect", "probe": "layers.count", "eq": 2 },
    { "do": "expect", "probe": "layers.previewDecoders", "max": 8 }
  ]
}
