{
  "delay": 120,
  "settle": 700,
  "steps": [
    { "label": "K at 2 s: the first keyframe, the transform shown" },
    { "do": "open", "file": "samples/counter-640p30.mp4" },
    { "do": "waitFor", "probe": "video.state", "eq": "ready", "timeout": 10000 },
    { "do": "expect", "probe": "keyframes.count", "eq": 0 },
    { "do": "type", "on": "transport.time", "text": "2" },
    { "do": "key", "keys": "K", "on": "MainWindow" },
    { "do": "expect", "probe": "keyframes.count", "eq": 1 },
    { "do": "expect", "probe": "keyframes.list", "eq": "2.000:320.0,180.0,1.000" },
    { "do": "expect", "probe": "options.keyframe.status", "eq": "Keyframe 1 of 1 at 00:00:02.00" },

    { "label": "the Selection at 4 s writes a second keyframe (none was there)" },
    { "do": "type", "on": "transport.time", "text": "4" },
    { "do": "key", "keys": "V", "on": "MainWindow" },
    { "do": "drag", "on": "canvas", "space": "canvas", "from": [320, 180], "to": [520, 180], "steps": 10 },
    { "do": "expect", "probe": "keyframes.count", "eq": 2 },
    { "do": "expect", "probe": "transform.x", "near": [520, 1] },

    { "label": "Linear: halfway at 3 s; the canvas shows the video there" },
    { "do": "type", "on": "transport.time", "text": "3" },
    { "do": "expect", "probe": "transform.x", "near": [420, 1] },
    { "do": "expect", "probe": "keyframes.current", "eq": -1 },
    { "do": "shot", "on": "CanvasArea", "file": "keyframes-halfway.png", "maxWidth": 1000 },

    { "label": "[ to the first, the Keyframe tool's Interpolation: Ease — a quarter of the way is 15.6 %" },
    { "do": "key", "keys": "[", "on": "MainWindow" },
    { "do": "expect", "probe": "playhead", "near": [2, 0.001] },
    { "do": "expect", "probe": "keyframes.current", "eq": 0 },
    { "do": "click", "on": "tool.keyframe" },
    { "do": "choose", "on": "options.keyframe.interp", "text": "Ease" },
    { "do": "expect", "probe": "keyframes.list", "contains": "2.000:320.0,180.0,1.000 ease" },
    { "do": "type", "on": "transport.time", "text": "2.5" },
    { "do": "expect", "probe": "transform.x", "near": [351.25, 1] },
    { "do": "key", "keys": "]", "on": "MainWindow" },
    { "do": "expect", "probe": "playhead", "near": [4, 0.001] },
    { "do": "shot", "on": "TopBar", "file": "keyframe-options.png", "maxWidth": 1400 },

    { "label": "a diamond dragged from 4 s to 4.5 s (the playhead goes with it); the row pictured" },
    { "do": "drag", "on": "timeline", "space": "timelineKeys", "from": [4.0, 0], "to": [4.5, 0], "steps": 8 },
    { "do": "expect", "probe": "keyframes.list", "contains": "|4.500:" },
    { "do": "expect", "probe": "keyframes.list", "lacks": "|4.000:" },
    { "do": "expect", "probe": "playhead", "near": [4.5, 0.001] },
    { "do": "shot", "on": "timeline", "file": "keyframes-row.png", "maxWidth": 1400 },

    { "label": "Delete on the timeline removes the keyframe at the playhead; Undo brings it back" },
    { "do": "click", "on": "timeline", "space": "timelineKeys", "at": [4.5, 0] },
    { "do": "key", "keys": "Delete", "on": "timeline" },
    { "do": "expect", "probe": "keyframes.count", "eq": 1 },
    { "do": "key", "keys": "Ctrl+Z", "on": "MainWindow" },
    { "do": "expect", "probe": "keyframes.count", "eq": 2 },

    { "label": "the options' Delete and Add; the last one deleted leaves the video where it is" },
    { "do": "click", "on": "options.keyframe.delete" },
    { "do": "expect", "probe": "keyframes.count", "eq": 1 },
    { "do": "expect", "probe": "transform.x", "near": [320, 1] },
    { "do": "key", "keys": "[", "on": "MainWindow" },
    { "do": "click", "on": "options.keyframe.delete" },
    { "do": "expect", "probe": "keyframes.count", "eq": 0 },
    { "do": "expect", "probe": "options.keyframe.status", "eq": "No keyframes: the video stays where it is" },
    { "do": "expect", "probe": "transform.x", "near": [320, 1] },
    { "do": "key", "keys": "Ctrl+Z", "on": "MainWindow" },
    { "do": "key", "keys": "Ctrl+Z", "on": "MainWindow" },
    { "do": "expect", "probe": "keyframes.count", "eq": 2 },
    { "do": "click", "on": "options.keyframe.add" },
    { "do": "expect", "probe": "keyframes.count", "eq": 2 }
  ]
}
