{
  "delay": 120,
  "settle": 700,
  "steps": [
    { "label": "no video: nothing to add; the queue is empty and saved" },
    { "do": "expect", "probe": "batch.count", "eq": 0 },
    { "do": "expect", "probe": "batch.saved", "eq": true },

    { "label": "the counter sample with an ellipse; three entries: VP9, GIF (60 fps asked: 50), ProRes" },
    { "do": "open", "file": "samples/counter-640p30.mp4" },
    { "do": "waitFor", "probe": "video.state", "eq": "ready", "timeout": 10000 },
    { "do": "key", "keys": "E", "on": "MainWindow" },
    { "do": "dclick", "on": "canvas", "space": "canvas", "at": [320, 180] },
    { "do": "batchAdd", "file": "one.webm", "temp": true },
    { "do": "choose", "on": "panel.output.format", "data": "gif" },
    { "do": "expect", "probe": "output.format", "eq": "gif" },
    { "do": "choose", "on": "panel.output.fps", "data": "60/1" },
    { "do": "expect", "probe": "output.fps", "eq": "50" },
    { "do": "expect", "probe": "output.note", "contains": "GIF plays at most 50 fps" },
    { "do": "shot", "on": "Section.output", "file": "output-gif.png" },
    { "do": "waitFor", "probe": "quality.estimate", "contains": "MB", "timeout": 20000 },
    { "do": "shot", "on": "Section.quality", "file": "quality-gif.png" },
    { "do": "batchAdd", "file": "two.gif", "temp": true },
    { "do": "choose", "on": "panel.output.fps", "data": "source" },
    { "do": "choose", "on": "panel.output.format", "data": "mov-prores" },
    { "do": "key", "keys": "Ctrl+Shift+E", "on": "MainWindow" },
    { "do": "expect", "probe": "batch.count", "eq": 3 },
    { "do": "expect", "probe": "batch.states", "eq": "pending,pending,pending" },
    { "do": "expect", "probe": "batch.files", "contains": "one.webm,two.gif," },

    { "label": "Menu → Batch Queue; ProRes dragged first" },
    { "do": "menu", "path": ["Batch Queue…"] },
    { "do": "expect", "probe": "batch.open", "eq": true },
    { "do": "batchMove", "from": 2, "to": 0 },
    { "do": "expect", "probe": "batch.files", "contains": ".mov,one.webm,two.gif" },
    { "do": "shot", "on": "BatchWindow", "file": "batch-pending.png" },

    { "label": "Start: one after another; Export waits meanwhile" },
    { "do": "batchStart" },
    { "do": "expect", "probe": "batch.started", "eq": true },
    { "do": "expect", "probe": "export.enabled", "eq": false },
    { "do": "waitFor", "probe": "batch.states", "eq": "done,done,done", "timeout": 120000 },
    { "do": "expect", "probe": "batch.started", "eq": false },
    { "do": "expect", "probe": "export.enabled", "eq": true },
    { "do": "shot", "on": "BatchWindow", "file": "batch-done.png" },

    { "label": "a failure keeps its reason and the next entry runs" },
    { "do": "batchAdd", "file": "no-such-folder/three.mov", "temp": true },
    { "do": "choose", "on": "panel.output.format", "data": "apng" },
    { "do": "batchAdd", "file": "four.apng", "temp": true },
    { "do": "batchStart" },
    { "do": "waitFor", "probe": "batch.started", "eq": false, "timeout": 120000 },
    { "do": "expect", "probe": "batch.states", "eq": "done,done,done,failed,done" },
    { "do": "expect", "probe": "batch.reasons", "contains": "no-such-folder/three.mov" },
    { "do": "shot", "on": "BatchWindow", "file": "batch-failed.png" },
    { "do": "click", "on": "batch.clear" },
    { "do": "expect", "probe": "batch.states", "eq": "failed" },
    { "do": "batchClose" },
    { "do": "expect", "probe": "batch.open", "eq": false }
  ]
}
