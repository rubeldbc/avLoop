{
  "delay": 120,
  "settle": 700,
  "steps": [
    { "label": "S9: a 3 s Crossfade loop of the counter, an Ellipse with Feather — the Preview shows only that" },
    { "do": "open", "file": "samples/counter-640p30.mp4" },
    { "do": "waitFor", "probe": "video.state", "eq": "ready", "timeout": 10000 },
    { "do": "type", "on": "transport.time", "text": "2" },
    { "do": "key", "keys": "I", "on": "MainWindow" },
    { "do": "type", "on": "transport.time", "text": "4.9667" },
    { "do": "key", "keys": "O", "on": "MainWindow" },
    { "do": "key", "keys": "E", "on": "MainWindow" },
    { "do": "dclick", "on": "canvas", "space": "canvas", "at": [320, 180] },
    { "do": "type", "on": "panel.crop.feather", "text": "12" },
    { "do": "expect", "probe": "crop.kind", "eq": "ellipse" },
    { "do": "expect", "probe": "preview.open", "eq": false },

    { "label": "F5 opens the Preview; Live makes every frame once, then plays from its cache" },
    { "do": "key", "keys": "F5", "on": "MainWindow" },
    { "do": "expect", "probe": "preview.open", "eq": true },
    { "do": "expect", "probe": "preview.length", "eq": 75 },
    { "do": "waitFor", "probe": "preview.cached", "eq": 75, "timeout": 30000 },
    { "do": "expect", "probe": "preview.info", "eq": "640×360 · 30 fps · 75 frames · 2.50 s · VP9 alpha" },
    { "do": "expect", "probe": "preview.frame", "eq": "640x360" },
    { "do": "expect", "probe": "preview.mode", "eq": "live" },
    { "do": "shot", "on": "PreviewWindow", "file": "preview-checker.png", "maxWidth": 1200 },
    { "do": "key", "keys": "F5", "on": "MainWindow" },
    { "do": "expect", "probe": "preview.open", "eq": true },

    { "label": "backgrounds and zoom" },
    { "do": "choose", "on": "preview.background", "data": 3 },
    { "do": "shot", "on": "preview.view", "file": "preview-green.png", "maxWidth": 900 },
    { "do": "choose", "on": "preview.background", "data": 4 },
    { "do": "shot", "on": "preview.view", "file": "preview-navy.png", "maxWidth": 900 },
    { "do": "choose", "on": "preview.background", "data": 2 },
    { "do": "choose", "on": "preview.background", "data": 1 },
    { "do": "choose", "on": "preview.background", "data": 0 },
    { "do": "choose", "on": "preview.zoom", "data": 1.0 },
    { "do": "shot", "on": "preview.view", "file": "preview-100.png", "maxWidth": 900 },
    { "do": "choose", "on": "preview.zoom", "data": 0.0 },

    { "label": "the keys and the transport: → and ←, Play, Around seam" },
    { "do": "key", "keys": "Right", "on": "PreviewWindow" },
    { "do": "expect", "probe": "preview.position", "eq": 1 },
    { "do": "key", "keys": "Left", "on": "PreviewWindow" },
    { "do": "key", "keys": "Left", "on": "PreviewWindow" },
    { "do": "expect", "probe": "preview.position", "eq": 74 },
    { "do": "click", "on": "preview.play" },
    { "do": "expect", "probe": "preview.playing", "eq": true },
    { "do": "wait", "ms": 1200 },
    { "do": "click", "on": "preview.play" },
    { "do": "expect", "probe": "preview.playing", "eq": false },
    { "do": "expect", "probe": "preview.position", "min": 20 },
    { "do": "expect", "probe": "preview.position", "max": 45 },
    { "do": "click", "on": "preview.aroundSeam" },
    { "do": "expect", "probe": "preview.aroundSeam", "eq": true },
    { "do": "click", "on": "preview.aroundSeam" },

    { "label": "Live frame 10 written for the comparison with avloop-cli" },
    { "do": "key", "keys": "Right", "on": "PreviewWindow" },
    { "do": "waitFor", "probe": "preview.playing", "eq": false },
    { "do": "projectSave", "file": "phases/26-10-26-034934-AvLoop/execution/AV-008-walk/preview.avloop" },

    { "label": "Encoded: encodes a temporary WebM, plays it back through libvpx, shows its size" },
    { "do": "click", "on": "preview.encoded" },
    { "do": "expect", "probe": "preview.mode", "eq": "encoded" },
    { "do": "waitFor", "probe": "preview.encode", "eq": "done", "timeout": 60000 },
    { "do": "expect", "probe": "preview.encodedBytes", "min": 2000 },
    { "do": "expect", "probe": "preview.status", "contains": "Encoded ·" },
    { "do": "expect", "probe": "preview.info", "contains": "MB" },
    { "do": "waitFor", "probe": "preview.cached", "min": 1, "timeout": 10000 },
    { "do": "shot", "on": "PreviewWindow", "file": "preview-encoded.png", "maxWidth": 1200 },
    { "do": "click", "on": "preview.live" },
    { "do": "expect", "probe": "preview.mode", "eq": "live" },

    { "label": "the frame at 10 in Live and in Encoded, and the encoded file kept for the check" },
    { "do": "key", "keys": "Right", "on": "PreviewWindow" },
    { "do": "previewSeek", "at": 10 },
    { "do": "waitFor", "probe": "preview.position", "eq": 10, "timeout": 5000 },
    { "do": "previewWrite", "file": "phases/26-10-26-034934-AvLoop/execution/AV-008-walk/live-10.rgba" },
    { "do": "click", "on": "preview.encoded" },
    { "do": "wait", "ms": 800 },
    { "do": "previewWrite", "file": "phases/26-10-26-034934-AvLoop/execution/AV-008-walk/encoded-10.rgba",
      "encoded": "phases/26-10-26-034934-AvLoop/execution/AV-008-walk/encoded.webm" },

    { "label": "a change in the main window: Live follows in 250 ms, Encoded goes out of date" },
    { "do": "type", "on": "panel.crop.feather", "text": "30" },
    { "do": "wait", "ms": 500 },
    { "do": "expect", "probe": "preview.encode", "eq": "outofdate" },
    { "do": "expect", "probe": "preview.status", "eq": "Out of date" },
    { "do": "click", "on": "preview.live" },
    { "do": "waitFor", "probe": "preview.cached", "eq": 75, "timeout": 30000 },

    { "label": "closing releases it; opening again starts fresh" },
    { "do": "previewClose" },
    { "do": "expect", "probe": "preview.open", "eq": false },
    { "do": "key", "keys": "F5", "on": "MainWindow" },
    { "do": "expect", "probe": "preview.open", "eq": true },
    { "do": "expect", "probe": "preview.encode", "eq": "none" },
    { "do": "previewClose" }
  ]
}
