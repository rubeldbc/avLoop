{
  "delay": 80,
  "settle": 600,
  "steps": [
    { "label": "S1: the window opens maximized with only three buttons in the top bar" },
    { "do": "expect", "probe": "window.frame", "contains": "frame" },
    { "do": "waitFor", "probe": "window.maximized", "eq": true, "timeout": 3000 },
    { "do": "expect", "probe": "topbar.buttons", "eq": "Open,Preview,Export" },
    { "do": "expect", "probe": "window.title", "eq": "AvLoop by Rubel" },
    { "label": "every icon of spec §5.3 is there and renders" },
    { "do": "expect", "probe": "icons.count", "eq": 49 },
    { "do": "expect", "probe": "icons.missing", "eq": "none" },
    { "do": "expect", "probe": "rail.count", "eq": 10 },
    { "do": "expect", "probe": "dropzone.visible", "eq": true },
    { "do": "expect", "probe": "status.source", "eq": "No video open" },
    { "label": "the rail's tools by their keys (the active tool turns orange)" },
    { "do": "expect", "probe": "tool.active", "eq": "select" },
    { "do": "key", "keys": "M" }, { "do": "expect", "probe": "tool.active", "eq": "crop-rect" },
    { "do": "key", "keys": "U" }, { "do": "expect", "probe": "tool.active", "eq": "crop-round" },
    { "do": "key", "keys": "E" }, { "do": "expect", "probe": "tool.active", "eq": "crop-ellipse" },
    { "do": "shot", "file": "rail-ellipse-active.png", "on": "ToolRail" },
    { "do": "key", "keys": "H" }, { "do": "expect", "probe": "tool.active", "eq": "hand" },
    { "do": "key", "keys": "Z" }, { "do": "expect", "probe": "tool.active", "eq": "zoom" },
    { "do": "click", "on": "tool.in" }, { "do": "expect", "probe": "tool.active", "eq": "in" },
    { "do": "click", "on": "tool.out" }, { "do": "expect", "probe": "tool.active", "eq": "out" },
    { "do": "key", "keys": "K" }, { "do": "expect", "probe": "tool.active", "eq": "keyframe" },
    { "do": "key", "keys": "V" }, { "do": "expect", "probe": "tool.active", "eq": "select" },
    { "label": "a click on the rail" },
    { "do": "click", "on": "tool.crop-ellipse" },
    { "do": "expect", "probe": "tool.active", "eq": "crop-ellipse" },
    { "do": "click", "on": "tool.select" },
    { "label": "the theme switches from the menu without a restart" },
    { "do": "shot", "file": "main-navy.png" },
    { "do": "menu", "path": ["Theme", "Black"] },
    { "do": "expect", "probe": "theme", "eq": "black" },
    { "do": "shot", "file": "main-black.png" },
    { "do": "menu", "path": ["Theme", "Navy"] },
    { "do": "expect", "probe": "theme", "eq": "navy" },
    { "label": "a section collapses and opens again" },
    { "do": "click", "on": "SectionHeader" },
    { "do": "shot", "file": "side-crop-closed.png", "on": "SidePanel" },
    { "do": "click", "on": "SectionHeader" },
    { "label": "the minimum size, then maximized again" },
    { "do": "resize", "w": 1280, "h": 720 },
    { "do": "expect", "probe": "window.size", "eq": "1280x720" },
    { "do": "shot", "file": "min-1280x720.png" },
    { "do": "maximize" },
    { "do": "expect", "probe": "window.maximized", "eq": true }
  ]
}
