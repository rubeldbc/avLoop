{
  "delay": 120,
  "settle": 700,
  "steps": [
    { "label": "S5: the crop tools on a 640×360 video, the view at 100 %" },
    { "do": "open", "file": "samples/counter-640p30.mp4" },
    { "do": "waitFor", "probe": "video.state", "eq": "ready", "timeout": 10000 },
    { "do": "wait", "ms": 300 },
    { "do": "key", "keys": "Ctrl+1", "on": "MainWindow" },
    { "do": "expect", "probe": "canvas.zoom", "eq": 1 },
    { "do": "expect", "probe": "crop.empty", "eq": true },
    { "do": "expect", "probe": "panel.crop.hint", "eq": true },
    { "do": "expect", "probe": "panel.crop.output", "eq": "640 × 360" },

    { "label": "M: a drag draws a rectangle in one Undo step; the bar and the panel follow" },
    { "do": "key", "keys": "M", "on": "MainWindow" },
    { "do": "expect", "probe": "tool.active", "eq": "crop-rect" },
    { "do": "drag", "on": "canvas", "space": "canvas", "from": [100, 60], "to": [300, 200], "steps": 20 },
    { "do": "expect", "probe": "crop.kind", "eq": "rect" },
    { "do": "expect", "probe": "crop.x", "near": [100, 0.6] },
    { "do": "expect", "probe": "crop.y", "near": [60, 0.6] },
    { "do": "expect", "probe": "crop.w", "near": [200, 0.01] },
    { "do": "expect", "probe": "crop.h", "near": [140, 0.01] },
    { "do": "expect", "probe": "undo.count", "eq": 1 },
    { "do": "expect", "probe": "options.rect.w", "near": [200, 0.06] },
    { "do": "expect", "probe": "panel.crop.w", "near": [200, 0.06] },
    { "do": "expect", "probe": "panel.crop.hint", "eq": false },
    { "do": "expect", "probe": "panel.crop.output", "eq": "200 × 140" },
    { "do": "expect", "probe": "status.notice", "eq": "" },

    { "label": "a drag inside moves it; the bottom-right handle resizes it" },
    { "do": "drag", "on": "canvas", "space": "canvas", "from": [200, 130], "to": [250, 160], "steps": 20 },
    { "do": "expect", "probe": "crop.x", "near": [150, 0.6] },
    { "do": "expect", "probe": "crop.y", "near": [90, 0.6] },
    { "do": "expect", "probe": "crop.w", "near": [200, 0.01] },
    { "do": "expect", "probe": "undo.count", "eq": 2 },
    { "do": "drag", "on": "canvas", "space": "canvas", "from": [350, 230], "to": [390, 250], "steps": 20 },
    { "do": "expect", "probe": "crop.w", "near": [240, 0.01] },
    { "do": "expect", "probe": "crop.h", "near": [160, 0.01] },
    { "do": "expect", "probe": "crop.x", "near": [150, 0.6] },
    { "do": "expect", "probe": "undo.count", "eq": 3 },
    { "do": "shot", "file": "crop-rect.png", "maxWidth": 1600 },

    { "label": "snapping: a left edge 5 px from the video's edge lands on it; with Ctrl it does not" },
    { "do": "drag", "on": "canvas", "space": "canvas", "from": [270, 170], "to": [125, 170], "steps": 20 },
    { "do": "expect", "probe": "crop.x", "near": [0, 0.001] },
    { "do": "key", "keys": "Ctrl+Z", "on": "MainWindow" },
    { "do": "expect", "probe": "crop.x", "near": [150, 0.6] },
    { "do": "drag", "on": "canvas", "space": "canvas", "from": [270, 170], "to": [125, 170], "mods": "Ctrl", "steps": 20 },
    { "do": "expect", "probe": "crop.x", "near": [5, 0.6] },
    { "do": "expect", "probe": "undo.count", "eq": 4 },

    { "label": "arrows move it 1 px, Shift 10 px; presses in a row are one Undo step" },
    { "do": "key", "keys": "Right", "on": "canvas" },
    { "do": "key", "keys": "Right", "on": "canvas" },
    { "do": "key", "keys": "Shift+Down", "on": "canvas" },
    { "do": "expect", "probe": "crop.x", "near": [7, 0.6] },
    { "do": "expect", "probe": "crop.y", "near": [100, 0.6] },
    { "do": "expect", "probe": "undo.count", "eq": 5 },

    { "label": "a drag outside draws a new crop in its place: Shift keeps 1:1, Alt draws from the centre" },
    { "do": "drag", "on": "canvas", "space": "canvas", "from": [400, 40], "to": [520, 100], "mods": "Shift", "steps": 20 },
    { "do": "expect", "probe": "crop.x", "near": [400, 0.6] },
    { "do": "expect", "probe": "crop.w", "near": [120, 0.01] },
    { "do": "expect", "probe": "crop.h", "near": [120, 0.01] },
    { "do": "expect", "probe": "undo.count", "eq": 6 },
    { "do": "drag", "on": "canvas", "space": "canvas", "from": [200, 250], "to": [265, 290], "mods": "Alt", "steps": 20 },
    { "do": "expect", "probe": "crop.cx", "near": [200, 0.6] },
    { "do": "expect", "probe": "crop.cy", "near": [250, 0.6] },
    { "do": "expect", "probe": "crop.w", "near": [130, 0.01] },
    { "do": "expect", "probe": "crop.h", "near": [80, 0.01] },
    { "do": "expect", "probe": "undo.count", "eq": 7 },

    { "label": "a drawing under 16 px is cancelled" },
    { "do": "drag", "on": "canvas", "space": "canvas", "from": [500, 300], "to": [510, 310], "steps": 10 },
    { "do": "expect", "probe": "crop.w", "near": [130, 0.01] },
    { "do": "expect", "probe": "undo.count", "eq": 7 },

    { "label": "Esc while drawing cancels the drawing" },
    { "do": "drag", "on": "canvas", "space": "canvas", "from": [450, 280], "to": [600, 340], "steps": 10, "keyBeforeRelease": "Escape" },
    { "do": "expect", "probe": "crop.w", "near": [130, 0.01] },
    { "do": "expect", "probe": "undo.count", "eq": 7 },

    { "label": "Ctrl+0 fits the crop, not the video" },
    { "do": "key", "keys": "Ctrl+0", "on": "MainWindow" },
    { "do": "expect", "probe": "canvas.zoom", "min": 3 },
    { "do": "shot", "file": "crop-fit.png", "maxWidth": 1600 },
    { "do": "key", "keys": "Ctrl+1", "on": "MainWindow" },
    { "do": "expect", "probe": "canvas.zoom", "eq": 1 },

    { "label": "ratios: Custom… takes the crop's own in lowest terms, W:H typed, 16:9 keeps the centre, W sets H, Swap" },
    { "do": "choose", "on": "options.rect.ratio", "data": "custom" },
    { "do": "expect", "probe": "crop.ratio", "eq": "13:8" },
    { "do": "expect", "probe": "crop.w", "near": [130, 0.01] },
    { "do": "type", "on": "options.rect.customW", "text": "2" },
    { "do": "type", "on": "options.rect.customH", "text": "1" },
    { "do": "expect", "probe": "crop.ratio", "eq": "2:1" },
    { "do": "expect", "probe": "crop.cx", "near": [200, 0.6] },
    { "do": "expect", "probe": "crop.w", "near": [144.22, 0.01] },
    { "do": "choose", "on": "options.rect.ratio", "data": "16:9" },
    { "do": "expect", "probe": "crop.ratio", "eq": "16:9" },
    { "do": "expect", "probe": "options.rect.ratio", "eq": "16:9" },
    { "do": "expect", "probe": "crop.cy", "near": [250, 0.6] },
    { "do": "type", "on": "options.rect.w", "text": "320" },
    { "do": "expect", "probe": "crop.w", "near": [320, 0.01] },
    { "do": "expect", "probe": "crop.h", "near": [180, 0.01] },
    { "do": "click", "on": "options.rect.swap" },
    { "do": "expect", "probe": "crop.w", "near": [180, 0.01] },
    { "do": "expect", "probe": "crop.h", "near": [320, 0.01] },
    { "do": "expect", "probe": "crop.ratio", "eq": "9:16" },
    { "do": "expect", "probe": "crop.cx", "near": [292.02, 0.6] },

    { "label": "every ratio in the list in turn: the centre stays, the area stays, 9:16 last brings back 180 × 320" },
    { "do": "choose", "on": "options.rect.ratio", "data": "free" },
    { "do": "expect", "probe": "crop.ratio", "eq": "free" },
    { "do": "expect", "probe": "crop.cx", "near": [292.02, 0.6] },
    { "do": "choose", "on": "options.rect.ratio", "data": "original" },
    { "do": "expect", "probe": "crop.ratio", "eq": "original" },
    { "do": "expect", "probe": "crop.cx", "near": [292.02, 0.6] },
    { "do": "choose", "on": "options.rect.ratio", "data": "1:1" },
    { "do": "expect", "probe": "crop.ratio", "eq": "1:1" },
    { "do": "expect", "probe": "crop.cx", "near": [292.02, 0.6] },
    { "do": "choose", "on": "options.rect.ratio", "data": "4:3" },
    { "do": "expect", "probe": "crop.ratio", "eq": "4:3" },
    { "do": "expect", "probe": "crop.cx", "near": [292.02, 0.6] },
    { "do": "choose", "on": "options.rect.ratio", "data": "3:4" },
    { "do": "expect", "probe": "crop.ratio", "eq": "3:4" },
    { "do": "expect", "probe": "crop.cx", "near": [292.02, 0.6] },
    { "do": "choose", "on": "options.rect.ratio", "data": "16:9" },
    { "do": "expect", "probe": "crop.ratio", "eq": "16:9" },
    { "do": "expect", "probe": "crop.cx", "near": [292.02, 0.6] },
    { "do": "choose", "on": "options.rect.ratio", "data": "21:9" },
    { "do": "expect", "probe": "crop.ratio", "eq": "21:9" },
    { "do": "expect", "probe": "crop.cx", "near": [292.02, 0.6] },
    { "do": "choose", "on": "options.rect.ratio", "data": "3:2" },
    { "do": "expect", "probe": "crop.ratio", "eq": "3:2" },
    { "do": "expect", "probe": "crop.cx", "near": [292.02, 0.6] },
    { "do": "choose", "on": "options.rect.ratio", "data": "2:3" },
    { "do": "expect", "probe": "crop.ratio", "eq": "2:3" },
    { "do": "expect", "probe": "crop.cx", "near": [292.02, 0.6] },
    { "do": "choose", "on": "options.rect.ratio", "data": "4:5" },
    { "do": "expect", "probe": "crop.ratio", "eq": "4:5" },
    { "do": "expect", "probe": "crop.cx", "near": [292.02, 0.6] },
    { "do": "choose", "on": "options.rect.ratio", "data": "9:16" },
    { "do": "expect", "probe": "crop.ratio", "eq": "9:16" },
    { "do": "expect", "probe": "crop.cx", "near": [292.02, 0.6] },
    { "do": "expect", "probe": "crop.w", "near": [180, 0.01] },
    { "do": "expect", "probe": "crop.h", "near": [320, 0.01] },

    { "label": "U: the crop becomes a Rounded rect; Radius and Feather; the output gains alpha" },
    { "do": "key", "keys": "U", "on": "MainWindow" },
    { "do": "expect", "probe": "tool.active", "eq": "crop-round" },
    { "do": "expect", "probe": "crop.kind", "eq": "rounded" },
    { "do": "expect", "probe": "crop.w", "near": [180, 0.01] },
    { "do": "type", "on": "options.rounded.radius", "text": "40" },
    { "do": "expect", "probe": "crop.radius", "eq": 40 },
    { "do": "type", "on": "options.rounded.feather", "text": "12" },
    { "do": "expect", "probe": "crop.feather", "eq": 12 },
    { "do": "expect", "probe": "panel.crop.output", "contains": "alpha" },
    { "do": "shot", "file": "crop-rounded.png", "maxWidth": 1600 },

    { "label": "E: an Ellipse; the panel's Feather is the same crop" },
    { "do": "key", "keys": "E", "on": "MainWindow" },
    { "do": "expect", "probe": "tool.active", "eq": "crop-ellipse" },
    { "do": "expect", "probe": "crop.kind", "eq": "ellipse" },
    { "do": "expect", "probe": "options.ellipse.feather", "eq": 12 },
    { "do": "shot", "file": "crop-ellipse.png", "maxWidth": 1600 },
    { "do": "type", "on": "panel.crop.feather", "text": "0" },
    { "do": "expect", "probe": "crop.feather", "eq": 0 },
    { "do": "expect", "probe": "options.ellipse.feather", "eq": 0 },
    { "do": "expect", "probe": "panel.crop.output", "contains": "alpha" },

    { "label": "a double-click makes it the whole video" },
    { "do": "dclick", "on": "canvas", "space": "canvas", "at": [200, 250] },
    { "do": "expect", "probe": "crop.x", "near": [0, 0.001] },
    { "do": "expect", "probe": "crop.w", "near": [640, 0.001] },
    { "do": "expect", "probe": "crop.h", "near": [360, 0.001] },
    { "do": "expect", "probe": "crop.kind", "eq": "ellipse" },

    { "label": "a crop past the video's edge, then wholly outside it: the status bar says so" },
    { "do": "type", "on": "options.ellipse.x", "text": "600" },
    { "do": "expect", "probe": "crop.x", "eq": 600 },
    { "do": "expect", "probe": "status.notice", "eq": "Transparent area in output" },
    { "do": "type", "on": "options.ellipse.x", "text": "2000" },
    { "do": "expect", "probe": "status.notice", "eq": "Output is fully transparent" },

    { "label": "Delete removes the crop; Undo brings it back" },
    { "do": "key", "keys": "Delete", "on": "canvas" },
    { "do": "expect", "probe": "crop.empty", "eq": true },
    { "do": "expect", "probe": "status.notice", "eq": "" },
    { "do": "expect", "probe": "panel.crop.hint", "eq": true },
    { "do": "key", "keys": "Ctrl+Z", "on": "MainWindow" },
    { "do": "expect", "probe": "crop.empty", "eq": false },
    { "do": "expect", "probe": "crop.x", "eq": 2000 },
    { "do": "key", "keys": "V", "on": "MainWindow" },
    { "do": "expect", "probe": "tool.active", "eq": "select" }
  ]
}
