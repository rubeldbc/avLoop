{
  "delay": 120,
  "settle": 700,
  "steps": [
    { "label": "D-021: the counter at 100 %; an ellipse crop drawn with E" },
    { "do": "open", "file": "samples/counter-640p30.mp4" },
    { "do": "waitFor", "probe": "video.state", "eq": "ready", "timeout": 10000 },
    { "do": "wait", "ms": 300 },
    { "do": "key", "keys": "Ctrl+1", "on": "MainWindow" },
    { "do": "key", "keys": "E", "on": "MainWindow" },
    { "do": "expect", "probe": "tool.active", "eq": "crop-ellipse" },
    { "do": "drag", "on": "canvas", "space": "canvas", "from": [220, 80], "to": [420, 280], "steps": 20 },
    { "do": "expect", "probe": "crop.kind", "eq": "ellipse" },
    { "do": "expect", "probe": "crop.w", "near": [200, 0.6] },
    { "do": "expect", "probe": "crop.invert", "eq": false },
    { "do": "expect", "probe": "panel.crop.output", "eq": "200 × 200 · alpha" },
    { "do": "expect", "probe": "undo.count", "eq": 1 },

    { "label": "Inverse in the Crop section: the whole video kept, the ellipse a hole; one Undo step" },
    { "do": "click", "on": "panel.crop.invert" },
    { "do": "expect", "probe": "crop.invert", "eq": true },
    { "do": "expect", "probe": "undo.count", "eq": 2 },
    { "do": "expect", "probe": "panel.crop.output", "eq": "640 × 360 · alpha" },
    { "do": "expect", "probe": "status.notice", "eq": "Transparent area in output" },
    { "do": "shot", "on": "canvas", "file": "canvas-inverse.png", "maxWidth": 1200 },
    { "do": "shot", "on": "Section.crop", "file": "panel-inverse.png" },

    { "label": "Feather 20 on the bar; the Preview shows the hole, softened outward" },
    { "do": "type", "on": "options.ellipse.feather", "text": "20" },
    { "do": "expect", "probe": "crop.feather", "eq": 20 },
    { "do": "key", "keys": "F5", "on": "MainWindow" },
    { "do": "expect", "probe": "preview.open", "eq": true },
    { "do": "waitFor", "probe": "preview.frame", "eq": "640x360", "timeout": 10000 },
    { "do": "wait", "ms": 800 },
    { "do": "shot", "on": "PreviewWindow", "file": "preview-inverse.png", "maxWidth": 1000 },
    { "do": "previewClose" },

    { "label": "Undo: the feather, then the inverse; Redo; the options bar's toggle the same" },
    { "do": "key", "keys": "Ctrl+Z", "on": "MainWindow" },
    { "do": "expect", "probe": "crop.feather", "eq": 0 },
    { "do": "key", "keys": "Ctrl+Z", "on": "MainWindow" },
    { "do": "expect", "probe": "crop.invert", "eq": false },
    { "do": "expect", "probe": "panel.crop.output", "eq": "200 × 200 · alpha" },
    { "do": "key", "keys": "Ctrl+Y", "on": "MainWindow" },
    { "do": "expect", "probe": "crop.invert", "eq": true },
    { "do": "click", "on": "options.ellipse.invert" },
    { "do": "expect", "probe": "crop.invert", "eq": false },
    { "do": "click", "on": "options.ellipse.invert" },
    { "do": "expect", "probe": "crop.invert", "eq": true },

    { "label": "M keeps the inverse; a new crop drawn outside keeps it; Delete clears both" },
    { "do": "key", "keys": "M", "on": "MainWindow" },
    { "do": "expect", "probe": "crop.kind", "eq": "rect" },
    { "do": "expect", "probe": "crop.invert", "eq": true },
    { "do": "drag", "on": "canvas", "space": "canvas", "from": [20, 20], "to": [140, 110], "steps": 16 },
    { "do": "expect", "probe": "crop.x", "near": [20, 0.6] },
    { "do": "expect", "probe": "crop.invert", "eq": true },
    { "do": "shot", "on": "canvas", "file": "canvas-inverse-rect.png", "maxWidth": 1200 },
    { "do": "key", "keys": "Delete", "on": "canvas" },
    { "do": "expect", "probe": "crop.empty", "eq": true },
    { "do": "expect", "probe": "crop.invert", "eq": false },
    { "do": "expect", "probe": "panel.crop.output", "eq": "640 × 360" }
  ]
}
