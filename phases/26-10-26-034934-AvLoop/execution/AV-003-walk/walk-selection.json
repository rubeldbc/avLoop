{
  "delay": 120,
  "settle": 700,
  "steps": [
    { "label": "S4: a video on the GL canvas, the Selection active" },
    { "do": "open", "file": "samples/counter-640p30.mp4" },
    { "do": "waitFor", "probe": "video.state", "eq": "ready", "timeout": 10000 },
    { "do": "wait", "ms": 300 },
    { "do": "expect", "probe": "canvas.gl", "eq": true },
    { "do": "expect", "probe": "tool.active", "eq": "select" },
    { "do": "expect", "probe": "transform.x", "eq": 320 },
    { "do": "expect", "probe": "transform.scale", "eq": 1 },
    { "do": "shot", "file": "selection-start.png", "maxWidth": 1600 },

    { "label": "a drag inside the video moves it (one Undo step)" },
    { "do": "drag", "on": "canvas", "space": "canvas", "from": [320, 180], "to": [420, 230], "steps": 20 },
    { "do": "expect", "probe": "transform.x", "near": [420, 1] },
    { "do": "expect", "probe": "transform.y", "near": [230, 1] },
    { "do": "expect", "probe": "undo.count", "eq": 1 },
    { "do": "expect", "probe": "options.x", "near": [420, 1] },

    { "label": "the bottom-right handle scales about the top-left corner, the ratio kept" },
    { "do": "drag", "on": "canvas", "space": "canvas", "from": [740, 410], "to": [1060, 590], "steps": 20 },
    { "do": "expect", "probe": "transform.scale", "near": [1.5, 0.01] },
    { "do": "expect", "probe": "transform.x", "near": [580, 1] },
    { "do": "expect", "probe": "transform.y", "near": [320, 1] },
    { "do": "expect", "probe": "options.scale", "near": [150, 0.6] },
    { "do": "expect", "probe": "options.upscaleWarning", "eq": true },
    { "do": "expect", "probe": "undo.count", "eq": 2 },
    { "do": "shot", "file": "selection-scaled.png", "maxWidth": 1600 },

    { "label": "Alt: the top-left handle scales about the centre" },
    { "do": "drag", "on": "canvas", "space": "canvas", "from": [100, 50], "to": [340, 185], "mods": "Alt", "steps": 20 },
    { "do": "expect", "probe": "transform.scale", "near": [0.75, 0.01] },
    { "do": "expect", "probe": "transform.x", "near": [580, 1] },
    { "do": "expect", "probe": "transform.y", "near": [320, 1] },
    { "do": "expect", "probe": "options.upscaleWarning", "eq": false },

    { "label": "Undo and Redo" },
    { "do": "key", "keys": "Ctrl+Z", "on": "MainWindow" },
    { "do": "expect", "probe": "transform.scale", "near": [1.5, 0.01] },
    { "do": "key", "keys": "Ctrl+Y", "on": "MainWindow" },
    { "do": "expect", "probe": "transform.scale", "near": [0.75, 0.01] },

    { "label": "the options bar: Scale typed, Fit, Fill, Center, Flip, Reset" },
    { "do": "type", "on": "options.scale", "text": "200" },
    { "do": "expect", "probe": "transform.scale", "near": [2.0, 0.0001] },
    { "do": "click", "on": "options.fit" },
    { "do": "expect", "probe": "transform.scale", "eq": 1 },
    { "do": "expect", "probe": "transform.x", "eq": 320 },
    { "do": "type", "on": "options.x", "text": "100" },
    { "do": "expect", "probe": "transform.x", "eq": 100 },
    { "do": "click", "on": "options.center" },
    { "do": "expect", "probe": "transform.x", "eq": 320 },
    { "do": "click", "on": "options.flipH" },
    { "do": "expect", "probe": "transform.flipH", "eq": true },
    { "do": "click", "on": "options.flipV" },
    { "do": "expect", "probe": "transform.flipV", "eq": true },
    { "do": "shot", "file": "selection-flipped.png", "maxWidth": 1600 },
    { "do": "click", "on": "options.reset" },
    { "do": "expect", "probe": "transform.flipH", "eq": false },
    { "do": "expect", "probe": "transform.scale", "eq": 1 },
    { "do": "expect", "probe": "undo.count", "min": 9 },

    { "label": "Zoom and Hand change the view, never Undo" },
    { "do": "expect", "probe": "undo.index", "eq": 10 },
    { "do": "key", "keys": "Z", "on": "MainWindow" },
    { "do": "expect", "probe": "tool.active", "eq": "zoom" },
    { "do": "key", "keys": "Ctrl+1", "on": "MainWindow" },
    { "do": "expect", "probe": "canvas.zoom", "eq": 1 },
    { "do": "click", "on": "canvas", "space": "canvas", "at": [320, 180] },
    { "do": "expect", "probe": "canvas.zoom", "eq": 1.5 },
    { "do": "click", "on": "canvas", "space": "canvas", "at": [320, 180], "mods": "Alt" },
    { "do": "expect", "probe": "canvas.zoom", "eq": 1 },
    { "do": "wheel", "on": "canvas", "space": "canvas", "at": [320, 180], "delta": 120, "mods": "Ctrl" },
    { "do": "expect", "probe": "canvas.zoom", "eq": 1.5 },
    { "do": "key", "keys": "H", "on": "MainWindow" },
    { "do": "drag", "on": "canvas", "from": [600, 300], "to": [500, 300], "steps": 10 },
    { "do": "expect", "probe": "canvas.panX", "near": [386.67, 1] },
    { "do": "drag", "on": "canvas", "from": [600, 300], "to": [600, 200], "button": "middle", "steps": 10 },
    { "do": "key", "keys": "Ctrl+0", "on": "MainWindow" },
    { "do": "expect", "probe": "canvas.panX", "near": [320, 1] },
    { "do": "expect", "probe": "undo.index", "eq": 10 },
    { "do": "key", "keys": "V", "on": "MainWindow" },
    { "do": "shot", "file": "selection-end.png", "maxWidth": 1600 }
  ]
}
