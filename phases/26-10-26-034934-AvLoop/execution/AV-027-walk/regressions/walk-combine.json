{
  "delay": 120,
  "settle": 700,
  "steps": [
    { "label": "D-023: two overlapping ellipses drawn with S on the counter at 100 %" },
    { "do": "open", "file": "samples/counter-640p30.mp4" },
    { "do": "waitFor", "probe": "video.state", "eq": "ready", "timeout": 10000 },
    { "do": "wait", "ms": 300 },
    { "do": "key", "keys": "Ctrl+1", "on": "MainWindow" },
    { "do": "key", "keys": "S", "on": "MainWindow" },
    { "do": "choose", "on": "options.shape.kind", "data": 2 },
    { "do": "drag", "on": "canvas", "space": "canvas", "from": [100, 80], "to": [300, 280], "steps": 12 },
    { "do": "key", "keys": "Escape", "on": "canvas" },
    { "do": "drag", "on": "canvas", "space": "canvas", "from": [240, 80], "to": [440, 280], "steps": 12 },
    { "do": "expect", "probe": "shapes.count", "eq": 2 },
    { "do": "expect", "probe": "shapes.summary", "contains": "ellipse:add:" },

    { "label": "Ctrl+A selects both; Combine ▸ Unite bakes one path (one Undo step); Undo gives the two back" },
    { "do": "key", "keys": "Ctrl+A", "on": "canvas" },
    { "do": "expect", "probe": "shapes.selected", "eq": "0,1" },
    { "do": "choose", "on": "panel.shapes.combineOp", "data": 0 },
    { "do": "click", "on": "panel.shapes.combine" },
    { "do": "expect", "probe": "shapes.count", "eq": 1 },
    { "do": "expect", "probe": "shapes.summary", "contains": "path:add:n" },
    { "do": "expect", "probe": "panel.shapes.rows", "eq": "Path 1 · Select" },
    { "do": "shot", "on": "canvas", "file": "canvas-unite.png", "maxWidth": 1200 },
    { "do": "key", "keys": "Ctrl+Z", "on": "MainWindow" },
    { "do": "expect", "probe": "shapes.count", "eq": 2 },

    { "label": "Minus front, Intersect, Exclude — each one path, each undone" },
    { "do": "key", "keys": "Ctrl+A", "on": "canvas" },
    { "do": "choose", "on": "panel.shapes.combineOp", "data": 1 },
    { "do": "click", "on": "panel.shapes.combine" },
    { "do": "expect", "probe": "shapes.count", "eq": 1 },
    { "do": "shot", "on": "canvas", "file": "canvas-minus.png", "maxWidth": 1200 },
    { "do": "key", "keys": "Ctrl+Z", "on": "MainWindow" },
    { "do": "key", "keys": "Ctrl+A", "on": "canvas" },
    { "do": "choose", "on": "panel.shapes.combineOp", "data": 2 },
    { "do": "click", "on": "panel.shapes.combine" },
    { "do": "expect", "probe": "shapes.count", "eq": 1 },
    { "do": "shot", "on": "canvas", "file": "canvas-intersect.png", "maxWidth": 1200 },
    { "do": "key", "keys": "Ctrl+Z", "on": "MainWindow" },
    { "do": "key", "keys": "Ctrl+A", "on": "canvas" },
    { "do": "choose", "on": "panel.shapes.combineOp", "data": 3 },
    { "do": "click", "on": "panel.shapes.combine" },
    { "do": "expect", "probe": "shapes.count", "eq": 1 },
    { "do": "shot", "on": "canvas", "file": "canvas-exclude.png", "maxWidth": 1200 },
    { "do": "key", "keys": "Ctrl+Z", "on": "MainWindow" },
    { "do": "expect", "probe": "shapes.count", "eq": 2 },

    { "label": "live roles: the top ellipse Keep only, then Exclude (the Crop section's Role)" },
    { "do": "click", "on": "canvas", "space": "canvas", "at": [400, 180] },
    { "do": "expect", "probe": "shapes.selected", "eq": "1" },
    { "do": "choose", "on": "panel.shapes.role", "data": 2 },
    { "do": "expect", "probe": "shapes.summary", "contains": ";ellipse:keep:" },
    { "do": "shot", "on": "canvas", "file": "canvas-keep.png", "maxWidth": 1200 },
    { "do": "choose", "on": "panel.shapes.role", "data": 3 },
    { "do": "expect", "probe": "shapes.summary", "contains": ";ellipse:exclude:" },
    { "do": "shot", "on": "canvas", "file": "canvas-exclude-live.png", "maxWidth": 1200 },
    { "do": "shot", "on": "Section.crop", "file": "panel-combine.png" },

    { "label": "a Ctrl+drag marquee selects what it touches" },
    { "do": "key", "keys": "Escape", "on": "canvas" },
    { "do": "drag", "on": "canvas", "space": "canvas", "from": [20, 20], "to": [150, 120], "steps": 8, "mods": "Ctrl" },
    { "do": "expect", "probe": "shapes.selected", "eq": "0" },
    { "do": "drag", "on": "canvas", "space": "canvas", "from": [20, 20], "to": [260, 120], "steps": 8, "mods": "Ctrl" },
    { "do": "expect", "probe": "shapes.selected", "eq": "0,1" },
    { "do": "expect", "probe": "shapes.count", "eq": 2 },

    { "label": "the Preview: Exclude live, exactly" },
    { "do": "key", "keys": "F5", "on": "MainWindow" },
    { "do": "waitFor", "probe": "preview.frame", "eq": "640x360", "timeout": 10000 },
    { "do": "wait", "ms": 800 },
    { "do": "shot", "on": "PreviewWindow", "file": "preview-exclude.png", "maxWidth": 1000 },
    { "do": "previewClose" }
  ]
}
