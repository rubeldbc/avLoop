{
  "delay": 120,
  "settle": 700,
  "steps": [
    { "label": "a video open, so the Export tab's name template has a name to make" },
    { "do": "open", "file": "samples/counter-640p30.mp4" },
    { "do": "waitFor", "probe": "video.state", "eq": "ready", "timeout": 10000 },
    { "do": "expect", "probe": "window.title", "eq": "AvLoop by Rubel — counter-640p30.mp4" },

    { "label": "Settings (Ctrl+,): General — the theme switched without a restart, the autosave minutes" },
    { "do": "key", "keys": "Ctrl+,", "on": "MainWindow" },
    { "do": "expect", "probe": "settings.open", "eq": true },
    { "do": "shot", "on": "SettingsDialog", "file": "settings-general.png" },
    { "do": "choose", "on": "settings.theme", "data": "black" },
    { "do": "expect", "probe": "theme", "eq": "black" },
    { "do": "shot", "on": "MainWindow", "file": "settings-black.png", "maxWidth": 1400 },
    { "do": "choose", "on": "settings.theme", "data": "navy" },
    { "do": "expect", "probe": "theme", "eq": "navy" },
    { "do": "type", "on": "settings.autosave", "text": "5" },
    { "do": "expect", "probe": "autosave.minutes", "eq": 5 },

    { "label": "Performance: the RAM cache applied at once" },
    { "do": "key", "keys": "Ctrl+Tab", "on": "settings.tabs" },
    { "do": "type", "on": "settings.ram", "text": "1024" },
    { "do": "expect", "probe": "cache.budgetMB", "eq": 1024 },
    { "do": "shot", "on": "SettingsDialog", "file": "settings-performance.png" },

    { "label": "Export: the name template" },
    { "do": "key", "keys": "Ctrl+Tab", "on": "settings.tabs" },
    { "do": "expect", "probe": "export.defaultName", "eq": "counter-640p30_loop_640x360.webm" },
    { "do": "type", "on": "settings.nameTemplate", "text": "{source}-{w}" },
    { "do": "expect", "probe": "export.defaultName", "eq": "counter-640p30-640.webm" },
    { "do": "shot", "on": "SettingsDialog", "file": "settings-export.png" },
    { "do": "click", "on": "settings.close" },
    { "do": "expect", "probe": "settings.open", "eq": false },

    { "label": "F1: the list of shortcuts, from the actions' own; Esc closes it" },
    { "do": "key", "keys": "F1", "on": "MainWindow" },
    { "do": "expect", "probe": "shortcuts.open", "eq": true },
    { "do": "shot", "on": "MainWindow", "file": "shortcuts.png", "maxWidth": 1400 },
    { "do": "key", "keys": "Esc", "on": "ShortcutOverlay" },
    { "do": "expect", "probe": "shortcuts.open", "eq": false },

    { "label": "About" },
    { "do": "menu", "path": ["About AvLoop by Rubel"] },
    { "do": "shot", "on": "AboutDialog", "file": "about.png" },
    { "do": "click", "on": "about.close" },

    { "label": "Presets: a built-in one applied (one Undo step), one saved and deleted" },
    { "do": "expect", "probe": "preset.current", "eq": "" },
    { "do": "choose", "on": "preset.box", "data": "OBS Lower Third 16:9 1280" },
    { "do": "expect", "probe": "output.sizeMode", "eq": "long-1280" },
    { "do": "expect", "probe": "preset.current", "eq": "OBS Lower Third 16:9 1280" },
    { "do": "key", "keys": "Ctrl+Z", "on": "MainWindow" },
    { "do": "expect", "probe": "output.sizeMode", "eq": "crop" },
    { "do": "expect", "probe": "preset.current", "eq": "" },
    { "do": "key", "keys": "Ctrl+Y", "on": "MainWindow" },
    { "do": "expect", "probe": "preset.current", "eq": "OBS Lower Third 16:9 1280" },
    { "do": "choose", "on": "panel.quality.preset", "data": "high" },
    { "do": "expect", "probe": "preset.current", "eq": "" },
    { "do": "answer", "text": "My overlay" },
    { "do": "click", "on": "preset.save" },
    { "do": "expect", "probe": "preset.names", "contains": "|My overlay" },
    { "do": "expect", "probe": "preset.current", "eq": "My overlay" },
    { "do": "shot", "on": "PresetRow", "file": "presets.png" },
    { "do": "answer", "yes": true },
    { "do": "click", "on": "preset.delete" },
    { "do": "expect", "probe": "question.last", "eq": "Delete the preset “My overlay”?" },
    { "do": "expect", "probe": "preset.names", "lacks": "My overlay" }
  ]
}
