{
  "delay": 120,
  "settle": 700,
  "steps": [
    { "label": "D-025: the counter; a value changed in every section" },
    { "do": "open", "file": "samples/counter-640p30.mp4" },
    { "do": "waitFor", "probe": "video.state", "eq": "ready", "timeout": 10000 },
    { "do": "wait", "ms": 300 },
    { "do": "key", "keys": "Ctrl+1", "on": "MainWindow" },
    { "do": "key", "keys": "E", "on": "MainWindow" },
    { "do": "drag", "on": "canvas", "space": "canvas", "from": [200, 80], "to": [400, 280], "steps": 12 },
    { "do": "type", "on": "panel.crop.feather", "text": "20" },
    { "do": "type", "on": "panel.loop.fade", "text": "1.2" },
    { "do": "type", "on": "panel.loop.speed", "text": "2" },
    { "do": "choose", "on": "panel.output.size", "data": "long-720" },
    { "do": "type", "on": "panel.quality.crf", "text": "20" },
    { "do": "type", "on": "panel.effects.exposure", "text": "2" },
    { "do": "type", "on": "panel.effects.sepia", "text": "40" },
    { "do": "expect", "probe": "crop.feather", "eq": 20 },
    { "do": "expect", "probe": "loop.speed", "eq": 2 },
    { "do": "expect", "probe": "effects.summary", "contains": "exposure=2" },
    { "do": "expect", "probe": "undo.count", "eq": 8 },

    { "label": "a click on a label resets its control — each one Undo step" },
    { "do": "click", "on": "panel.crop.feather.label" },
    { "do": "expect", "probe": "crop.feather", "eq": 0 },
    { "do": "click", "on": "panel.loop.speed.label" },
    { "do": "expect", "probe": "loop.speed", "eq": 1 },
    { "do": "click", "on": "panel.loop.fadeRow.label" },
    { "do": "expect", "probe": "loop.plan", "contains": "F15" },
    { "do": "click", "on": "panel.effects.exposure.label" },
    { "do": "expect", "probe": "effects.summary", "eq": "sepia=40" },
    { "do": "expect", "probe": "undo.count", "eq": 12 },

    { "label": "Undo gives each value back" },
    { "do": "key", "keys": "Ctrl+Z", "on": "MainWindow" },
    { "do": "expect", "probe": "effects.summary", "contains": "exposure=2" },
    { "do": "key", "keys": "Ctrl+Z", "on": "MainWindow" },
    { "do": "key", "keys": "Ctrl+Z", "on": "MainWindow" },
    { "do": "expect", "probe": "loop.speed", "eq": 2 },
    { "do": "key", "keys": "Ctrl+Y", "on": "MainWindow" },
    { "do": "key", "keys": "Ctrl+Y", "on": "MainWindow" },
    { "do": "key", "keys": "Ctrl+Y", "on": "MainWindow" },

    { "label": "a right click on a group: Reset <group> — one Undo step each" },
    { "do": "choose", "on": "panel.loop.mode", "data": 2 },
    { "do": "expect", "probe": "loop.mode", "eq": "pingpong" },
    { "do": "shot", "on": "SidePanel", "file": "panel-before-reset.png" },
    { "do": "context", "on": "Section.effects", "path": ["Reset Clip effects"] },
    { "do": "expect", "probe": "effects.summary", "eq": "" },
    { "do": "context", "on": "Section.quality", "path": ["Reset Quality"] },
    { "do": "expect", "probe": "quality.crf", "eq": 31 },
    { "do": "context", "on": "Section.output", "path": ["Reset Output"] },
    { "do": "expect", "probe": "output.sizeMode", "eq": "crop" },
    { "do": "context", "on": "Section.loop", "path": ["Reset Loop"] },
    { "do": "expect", "probe": "loop.speed", "eq": 1 },
    { "do": "expect", "probe": "loop.mode", "eq": "crossfade" },
    { "do": "context", "on": "Section.crop", "path": ["Reset Crop"] },
    { "do": "expect", "probe": "crop.empty", "eq": true },
    { "do": "shot", "on": "SidePanel", "file": "panel-after-reset.png" },

    { "label": "Undo through the group resets" },
    { "do": "key", "keys": "Ctrl+Z", "on": "MainWindow" },
    { "do": "expect", "probe": "crop.empty", "eq": false },
    { "do": "key", "keys": "Ctrl+Z", "on": "MainWindow" },
    { "do": "expect", "probe": "loop.mode", "eq": "pingpong" },

    { "label": "the options bars: E's Feather label and the bar's Reset; the Selection's Scale label" },
    { "do": "type", "on": "options.ellipse.feather", "text": "33" },
    { "do": "expect", "probe": "crop.feather", "eq": 33 },
    { "do": "click", "on": "options.ellipse.feather.label" },
    { "do": "expect", "probe": "crop.feather", "eq": 0 },
    { "do": "type", "on": "options.ellipse.feather", "text": "12" },
    { "do": "context", "on": "options.crop-ellipse", "path": ["Reset Crop: Ellipse"] },
    { "do": "expect", "probe": "crop.feather", "eq": 0 },
    { "do": "key", "keys": "V", "on": "MainWindow" },
    { "do": "type", "on": "options.scale", "text": "150" },
    { "do": "expect", "probe": "transform.scale", "near": [1.5, 0.001] },
    { "do": "click", "on": "options.scale.label" },
    { "do": "expect", "probe": "transform.scale", "near": [1, 0.001] }
  ]
}
