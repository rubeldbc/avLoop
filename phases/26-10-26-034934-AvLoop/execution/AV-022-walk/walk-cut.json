{
  "delay": 120,
  "settle": 700,
  "steps": [
    { "label": "D-020: the counter, In 1 s, Out 3 s (D = 60 at 30 fps); the default loop is Crossfade" },
    { "do": "open", "file": "samples/counter-640p30.mp4" },
    { "do": "waitFor", "probe": "video.state", "eq": "ready", "timeout": 10000 },
    { "do": "type", "on": "transport.time", "text": "1" },
    { "do": "key", "keys": "I", "on": "MainWindow" },
    { "do": "type", "on": "transport.time", "text": "2.9667" },
    { "do": "key", "keys": "O", "on": "MainWindow" },
    { "do": "expect", "probe": "range.out", "near": [3, 0.001] },
    { "do": "expect", "probe": "loop.mode", "eq": "crossfade" },
    { "do": "expect", "probe": "loop.plan", "eq": "D60 F15 T9 L45" },
    { "do": "expect", "probe": "panel.loop.summary", "eq": "Loop 1.50 s · 45 frames @ 30 fps" },
    { "do": "expect", "probe": "export.defaultName", "contains": "_loop_" },
    { "do": "shot", "on": "TimelineArea", "file": "timeline-crossfade.png" },

    { "label": "Mode None: the clip as cut — L = D, the summary says Clip, no band, the name says clip" },
    { "do": "choose", "on": "panel.loop.mode", "data": 4 },
    { "do": "expect", "probe": "loop.mode", "eq": "none" },
    { "do": "expect", "probe": "loop.plan", "eq": "D60 F15 T9 L60" },
    { "do": "expect", "probe": "panel.loop.summary", "eq": "Clip 2.00 s · 60 frames @ 30 fps" },
    { "do": "expect", "probe": "timeline.fadeEdge", "near": [3, 0.001] },
    { "do": "expect", "probe": "export.defaultName", "eq": "counter-640p30_clip_640x360.webm" },
    { "do": "shot", "on": "TimelineArea", "file": "timeline-none.png" },
    { "do": "shot", "on": "Section.loop", "file": "loop-panel-none.png" },

    { "label": "the Preview: 60 frames, no seam mark, Around seam not offered" },
    { "do": "key", "keys": "F5", "on": "MainWindow" },
    { "do": "expect", "probe": "preview.open", "eq": true },
    { "do": "expect", "probe": "preview.length", "eq": 60 },
    { "do": "waitFor", "probe": "preview.cached", "eq": 60, "timeout": 30000 },
    { "do": "expect", "probe": "preview.aroundSeamEnabled", "eq": false },
    { "do": "expect", "probe": "preview.aroundSeam", "eq": false },
    { "do": "shot", "on": "PreviewWindow", "file": "preview-none.png", "maxWidth": 1200 },
    { "do": "previewClose" },
    { "do": "expect", "probe": "preview.open", "eq": false },

    { "label": "Undo: back to Crossfade, the loop's words again; Redo: None" },
    { "do": "key", "keys": "Ctrl+Z", "on": "MainWindow" },
    { "do": "expect", "probe": "loop.mode", "eq": "crossfade" },
    { "do": "expect", "probe": "panel.loop.summary", "eq": "Loop 1.50 s · 45 frames @ 30 fps" },
    { "do": "expect", "probe": "export.defaultName", "contains": "_loop_" },
    { "do": "key", "keys": "Ctrl+Y", "on": "MainWindow" },
    { "do": "expect", "probe": "loop.mode", "eq": "none" },

    { "label": "the Preview of a loop again offers Around seam" },
    { "do": "choose", "on": "panel.loop.mode", "data": 0 },
    { "do": "expect", "probe": "loop.mode", "eq": "simple" },
    { "do": "key", "keys": "F5", "on": "MainWindow" },
    { "do": "expect", "probe": "preview.open", "eq": true },
    { "do": "expect", "probe": "preview.aroundSeamEnabled", "eq": true },
    { "do": "previewClose" }
  ]
}
