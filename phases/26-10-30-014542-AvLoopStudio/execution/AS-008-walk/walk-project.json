{
  "delay": 120,
  "settle": 700,
  "steps": [
    { "label": "D-038: a sequence made — the 1080p counter inserted at 2 s, the last clip cut at 16 s, a hole in it" },
    { "do": "resize", "w": 1440, "h": 900 },
    { "do": "open", "file": "samples/counter-640p30.mp4" },
    { "do": "waitFor", "probe": "video.state", "eq": "ready", "timeout": 10000 },
    { "do": "import", "files": ["samples/counter-1080p30.mp4"] },
    { "do": "type", "on": "transport.time", "text": "2" },
    { "do": "click", "on": "project.insert" },
    { "do": "key", "keys": "C", "on": "MainWindow" },
    { "do": "click", "on": "lanes", "space": "lanes", "at": [16, 1] },
    { "do": "key", "keys": "V", "on": "MainWindow" },
    { "do": "click", "on": "lanes", "space": "lanes", "at": [17, 1] },
    { "do": "click", "on": "controls.addEllipse" },
    { "do": "choose", "on": "controls.maskMode", "data": "cut" },
    { "do": "expect", "probe": "sequence.ends", "eq": "V1:0.00-2.00,2.00-12.00,12.00-16.00,16.00-20.00" },

    { "label": "Save As studio.avloop; New; the project opened again — the same sequence, the hole, the bin" },
    { "do": "saveAs", "file": "studio.avloop" },
    { "do": "expect", "probe": "project.path", "contains": "studio.avloop" },
    { "do": "expect", "probe": "project.dirty", "eq": false },
    { "do": "menu", "path": ["New"] },
    { "do": "expect", "probe": "sequence.clips", "eq": 1 },
    { "do": "expect", "probe": "video.state", "eq": "none" },
    { "do": "project", "file": "phases/26-10-30-014542-AvLoopStudio/execution/AS-008-walk/studio.avloop" },
    { "do": "waitFor", "probe": "video.state", "eq": "ready", "timeout": 10000 },
    { "do": "expect", "probe": "sequence.ends", "eq": "V1:0.00-2.00,2.00-12.00,12.00-16.00,16.00-20.00" },
    { "do": "expect", "probe": "project.media", "eq": 2 },
    { "do": "click", "on": "lanes", "space": "lanes", "at": [17, 1] },
    { "do": "expect", "probe": "controls.maskList", "eq": "ellipse:cut" },
    { "do": "expect", "probe": "monitor.composite", "eq": true },
    { "do": "expect", "probe": "project.dirty", "eq": false },
    { "do": "type", "on": "transport.time", "text": "17" },
    { "do": "wait", "ms": 700 },
    { "do": "shot", "on": "MainWindow", "file": "reopened-17s.png", "maxWidth": 1440 },

    { "label": "an AvLoop project of version 3 opened: a sequence, said so; its file untouched" },
    { "do": "project", "file": "phases/26-10-30-014542-AvLoopStudio/execution/AS-008-walk/avloop-v3.avloop" },
    { "do": "waitFor", "probe": "video.state", "eq": "ready", "timeout": 10000 },
    { "do": "expect", "probe": "toast.text", "contains": "opened as a sequence" },
    { "do": "expect", "probe": "sequence.ends", "eq": "V1:0.00-10.00 V2:1.00-4.00" },
    { "do": "expect", "probe": "layers.count", "eq": 1 },
    { "do": "expect", "probe": "crop.kind", "eq": "ellipse" },
    { "do": "expect", "probe": "output.size", "eq": "400x280" },
    { "do": "expect", "probe": "playhead", "near": [0, 0.001] },
    { "do": "shot", "on": "MainWindow", "file": "avloop-v3-opened.png", "maxWidth": 1440 }
  ]
}
