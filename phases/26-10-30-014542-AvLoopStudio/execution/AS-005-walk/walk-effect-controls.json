{
  "delay": 120,
  "settle": 700,
  "steps": [
    { "label": "D-035: the counter; the 1080p counter overwritten on V2 at 0 s — the Effect Controls show the main clip" },
    { "do": "resize", "w": 1440, "h": 900 },
    { "do": "open", "file": "samples/counter-640p30.mp4" },
    { "do": "waitFor", "probe": "video.state", "eq": "ready", "timeout": 10000 },
    { "do": "expect", "probe": "controls.clip", "eq": "counter-640p30" },
    { "do": "import", "files": ["samples/counter-1080p30.mp4"] },
    { "do": "choose", "on": "project.track", "text": "V2" },
    { "do": "click", "on": "project.overwrite" },
    { "do": "expect", "probe": "sequence.ends", "eq": "V1:0.00-10.00 V2:0.00-10.00" },

    { "label": "a click on its bar selects it: the Effect Controls are its; Scale 25 %, its place the top-left quarter" },
    { "do": "click", "on": "lanes", "space": "lanes", "at": [5, 2] },
    { "do": "expect", "probe": "controls.clip", "eq": "counter-1080p30" },
    { "do": "type", "on": "controls.scale", "text": "25" },
    { "do": "type", "on": "controls.x", "text": "160" },
    { "do": "type", "on": "controls.y", "text": "90" },
    { "do": "expect", "probe": "controls.look", "eq": "160.0,90.0,25.0,100.0" },
    { "do": "expect", "probe": "controls.keyCount", "eq": 0 },

    { "label": "the stopwatch at 0 s: a key; at 2 s X 480, Y 270 and Opacity 0 write a second; at 1 s half way" },
    { "do": "type", "on": "transport.time", "text": "0" },
    { "do": "click", "on": "controls.keys" },
    { "do": "expect", "probe": "controls.keyCount", "eq": 1 },
    { "do": "type", "on": "transport.time", "text": "2" },
    { "do": "type", "on": "controls.x", "text": "480" },
    { "do": "type", "on": "controls.y", "text": "270" },
    { "do": "type", "on": "controls.opacity", "text": "0" },
    { "do": "expect", "probe": "controls.keyCount", "eq": 2 },
    { "do": "type", "on": "transport.time", "text": "1" },
    { "do": "expect", "probe": "controls.look", "eq": "320.0,180.0,25.0,50.0" },
    { "do": "click", "on": "controls.prev" },
    { "do": "expect", "probe": "playhead", "near": [0, 0.001] },
    { "do": "click", "on": "controls.next" },
    { "do": "expect", "probe": "playhead", "near": [2, 0.001] },

    { "label": "a mask: an ellipse over its middle, Mode Cut — a hole in V2; Invert on V2's clip effects alone" },
    { "do": "click", "on": "controls.addEllipse" },
    { "do": "expect", "probe": "controls.maskList", "eq": "ellipse:add" },
    { "do": "choose", "on": "controls.maskMode", "data": "cut" },
    { "do": "expect", "probe": "controls.maskList", "eq": "ellipse:cut" },
    { "do": "click", "on": "panel.effects.invert" },
    { "do": "expect", "probe": "effects.main", "eq": false },
    { "do": "expect", "probe": "monitor.composite", "eq": true },
    { "do": "type", "on": "transport.time", "text": "1" },
    { "do": "wait", "ms": 600 },
    { "do": "shot", "on": "SidePanel", "file": "effect-controls.png" },
    { "do": "shot", "on": "CanvasArea", "file": "monitor-1s.png", "maxWidth": 1000 },
    { "do": "saveAs", "file": "controls.avloop" }
  ]
}
